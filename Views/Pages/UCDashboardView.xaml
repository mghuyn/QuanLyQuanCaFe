<UserControl x:Class="QuanLyQuanCaFe.Views.Pages.UCDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:QuanLyQuanCaFe.ViewModels"
             Background="#F6F8FC">

    <UserControl.DataContext>
        <vm:DashboardViewModel/>
    </UserControl.DataContext>

    <UserControl.Resources>
        <Style x:Key="DashboardCard" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="22"/>
            <Setter Property="Padding" Value="22"/>
        </Style>

        <Style x:Key="QuickButton" TargetType="Button">
            <Setter Property="Height" Value="88"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="{Binding Loi}"
                   Foreground="#DC2626"
                   FontSize="13"
                   TextWrapping="Wrap"
                   Margin="0,0,0,12"/>

        <!-- SUMMARY CARDS -->
        <UniformGrid Grid.Row="1"
                     Columns="4"
                     Rows="1"
                     Margin="0,0,0,24">

            <Border Style="{StaticResource DashboardCard}"
                    Margin="0,0,14,0">
                <StackPanel>
                    <TextBlock Text="Sản phẩm"
                               Foreground="#64748B"
                               FontSize="13"/>

                    <TextBlock Text="{Binding SoSanPham}"
                               FontSize="30"
                               FontWeight="Bold"
                               Foreground="#0F172A"
                               Margin="0,10,0,0"/>

                    <TextBlock Text="Đang có trong menu"
                               Foreground="#2563EB"
                               FontSize="13"
                               Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource DashboardCard}"
                    Margin="0,0,14,0">
                <StackPanel>
                    <TextBlock Text="Nhân viên"
                               Foreground="#64748B"
                               FontSize="13"/>

                    <TextBlock Text="{Binding SoNhanVien}"
                               FontSize="30"
                               FontWeight="Bold"
                               Foreground="#0F172A"
                               Margin="0,10,0,0"/>

                    <TextBlock Text="Đang hoạt động"
                               Foreground="#10B981"
                               FontSize="13"
                               Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource DashboardCard}"
                    Margin="0,0,14,0">
                <StackPanel>
                    <TextBlock Text="Bàn"
                               Foreground="#64748B"
                               FontSize="13"/>

                    <TextBlock Text="{Binding SoBan}"
                               FontSize="30"
                               FontWeight="Bold"
                               Foreground="#0F172A"
                               Margin="0,10,0,0"/>

                    <TextBlock Text="Tổng số bàn"
                               Foreground="#F59E0B"
                               FontSize="13"
                               Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource DashboardCard}">
                <StackPanel>
                    <TextBlock Text="Hóa đơn hôm nay"
                               Foreground="#64748B"
                               FontSize="13"/>

                    <TextBlock Text="{Binding SoHoaDonHomNay}"
                               FontSize="30"
                               FontWeight="Bold"
                               Foreground="#0F172A"
                               Margin="0,10,0,0"/>

                    <TextBlock Text="Đơn bán trong ngày"
                               Foreground="#EF4444"
                               FontSize="13"
                               Margin="0,8,0,0"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- BODY -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="1.05*"/>
            </Grid.ColumnDefinitions>

            <!-- SALES ACTIVITY -->
            <Border Grid.Column="0"
                    Background="White"
                    CornerRadius="24"
                    Padding="24"
                    Margin="0,0,14,0">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0"
                               LastChildFill="False"
                               Margin="0,0,0,18">

                        <StackPanel DockPanel.Dock="Left">
                            <TextBlock Text="Hoạt động bán hàng"
                                       FontSize="21"
                                       FontWeight="Bold"
                                       Foreground="#0F172A"/>

                            <TextBlock Text="Doanh thu theo khung giờ trong ngày"
                                       Foreground="#64748B"
                                       FontSize="13"
                                       Margin="0,6,0,0"/>
                        </StackPanel>

                        <Border DockPanel.Dock="Right"
                                Background="#EFF6FF"
                                CornerRadius="14"
                                Padding="12,6"
                                VerticalAlignment="Top">
                            <TextBlock Text="Hôm nay"
                                       Foreground="#0B63F6"
                                       FontWeight="SemiBold"
                                       FontSize="12"/>
                        </Border>
                    </DockPanel>

                    <Border Grid.Row="1"
                            Background="#F8FAFC"
                            CornerRadius="20"
                            Padding="20">

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <ItemsControl Grid.Row="0"
                                          ItemsSource="{Binding DoanhThuTheoGio}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="8"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>

                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="6,0">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <StackPanel Grid.Row="0"
                                                        VerticalAlignment="Bottom">
                                                <TextBlock Text="{Binding DoanhThuText, Mode=OneWay}"
                                                           FontSize="10"
                                                           Foreground="#64748B"
                                                           TextAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"
                                                           Margin="0,0,0,6"/>

                                                <Border Height="{Binding DoCaoCot, Mode=OneWay}"
                                                        Background="#0B63F6"
                                                        CornerRadius="9"
                                                        MinHeight="8"/>
                                            </StackPanel>

                                            <StackPanel Grid.Row="1"
                                                        Margin="0,10,0,0">
                                                <TextBlock Text="{Binding GioText, Mode=OneWay}"
                                                           HorizontalAlignment="Center"
                                                           FontSize="11"
                                                           Foreground="#64748B"/>

                                                <TextBlock Text="{Binding SoHoaDonText, Mode=OneWay}"
                                                           HorizontalAlignment="Center"
                                                           FontSize="10"
                                                           Foreground="#94A3B8"
                                                           Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Grid.Row="1"
                                       Text="Dữ liệu lấy từ HoaDonBans theo NgayLapHoaDon hôm nay"
                                       Foreground="#94A3B8"
                                       FontSize="11"
                                       HorizontalAlignment="Right"
                                       Margin="0,12,0,0"/>
                        </Grid>
                    </Border>                </Grid>
            </Border>

            <!-- QUICK INFO -->
            <Border Grid.Column="1"
                    Background="White"
                    CornerRadius="24"
                    Padding="24">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                      
                    </Grid.RowDefinitions>

                    
                    
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
