<UserControl x:Class="QuanLyQuanCaFe.Views.Pages.UCPosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:QuanLyQuanCaFe.ViewModels"
             xmlns:converters="clr-namespace:QuanLyQuanCaFe.Services"
             Background="#F6F8FC">

    <UserControl.DataContext>
        <vm:PosViewModel/>
    </UserControl.DataContext>

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:ImagePathConverter x:Key="ImagePathConverter"/>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Background" Value="#0B63F6"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="DarkButton" TargetType="Button">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Background" Value="#111827"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="LightButton" TargetType="Button">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="DangerButton" TargetType="Button">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Background" Value="#FEE2E2"/>
            <Setter Property="Foreground" Value="#DC2626"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="WatermarkTextBox" TargetType="TextBox">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Grid>
                            <ScrollViewer x:Name="PART_ContentHost"/>
                            <TextBlock x:Name="Watermark"
                                       Text="{TemplateBinding Tag}"
                                       Foreground="#94A3B8"
                                       Margin="10,0,0,0"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False"
                                       Visibility="Collapsed"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="Watermark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Watermark" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <Grid Margin="16">
        <TabControl Background="Transparent"
                    BorderThickness="0">

            <!-- TAB 1: TẠO HÓA ĐƠN -->
            <TabItem Header="Tạo hóa đơn">
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="380"/>
                    </Grid.ColumnDefinitions>

                    <!-- LEFT: MENU -->
                    <Border Grid.Column="0"
                            IsEnabled="{Binding DangLapHoaDon}"
                            Background="White"
                            CornerRadius="26"
                            Padding="20"
                            Margin="0,0,14,0">

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- HEADER BILL INFO -->
                            <StackPanel Grid.Row="0">
                                <TextBlock Text="Bán hàng"
                                           FontSize="28"
                                           FontWeight="Bold"
                                           Foreground="#0F172A"/>
                            </StackPanel>

                            <!-- BILL OPTIONS -->
                            <Grid Grid.Row="1"
                                  Margin="0,16,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="230"/>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="190"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <GroupBox Grid.Column="0"
                                          Header="Hình thức"
                                          Margin="0,0,10,0"
                                          Padding="10,4"
                                          Foreground="#1D4ED8">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton Content="Ngồi lại"
                                                     GroupName="LoaiHoaDonGroup"
                                                     IsChecked="{Binding IsDineIn, Mode=TwoWay}"
                                                     Margin="0,0,18,0"
                                                     VerticalAlignment="Center"
                                                     FontWeight="SemiBold"
                                                     Foreground="#0F172A"/>
                                        <RadioButton Content="Mang về"
                                                     GroupName="LoaiHoaDonGroup"
                                                     IsChecked="{Binding IsTakeAway, Mode=TwoWay}"
                                                     VerticalAlignment="Center"
                                                     FontWeight="SemiBold"
                                                     Foreground="#0F172A"/>
                                    </StackPanel>
                                </GroupBox>

                                <Button Grid.Column="1"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Padding="0"
                                        Cursor="Hand"
                                        Margin="0,0,10,0"
                                        Command="{Binding MoChonBanCommand}"
                                        IsEnabled="{Binding CoTheChonBan}">
                                    <Border Background="#F8FAFC"
                                            CornerRadius="18"
                                            Padding="12">
                                        <StackPanel>
                                            <TextBlock Text="Bàn"
                                                       FontSize="11"
                                                       Foreground="#64748B"/>
                                            <TextBlock Text="{Binding TenBanDangChon}"
                                                       FontWeight="Bold"
                                                       Foreground="#0F172A"
                                                       TextTrimming="CharacterEllipsis"
                                                       Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </Button>

                                <Button Grid.Column="2"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Padding="0"
                                        Cursor="Hand"
                                        Margin="0,0,10,0"
                                        Command="{Binding MoChonKhachHangCommand}">
                                    <Border Background="#F8FAFC"
                                            CornerRadius="18"
                                            Padding="12">
                                        <StackPanel>
                                            <TextBlock Text="Khách hàng"
                                                       FontSize="11"
                                                       Foreground="#64748B"/>
                                            <TextBlock Text="{Binding TenKhachHangDangChon}"
                                                       FontWeight="Bold"
                                                       Foreground="#0F172A"
                                                       TextTrimming="CharacterEllipsis"
                                                       Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </Button>

                                <Border Grid.Column="3"
                                        Background="#F8FAFC"
                                        CornerRadius="18"
                                        Padding="12,0">
                                    <TextBox Text="{Binding GhiChuHoaDon, UpdateSourceTrigger=PropertyChanged}"
                                             Tag="Ghi chú hóa đơn..."
                                             Style="{StaticResource WatermarkTextBox}"/>
                                </Border>
                            </Grid>

                            <!-- SEARCH -->
                            <Border Grid.Row="2"
                                    Height="46"
                                    Background="#F8FAFC"
                                    CornerRadius="18"
                                    Padding="14,0"
                                    Margin="0,0,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="🔍"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Center"/>

                                    <TextBox Grid.Column="1"
                                             Text="{Binding TuKhoa, UpdateSourceTrigger=PropertyChanged}"
                                             Tag="Nhập từ khóa tìm kiếm món..."
                                             Style="{StaticResource WatermarkTextBox}"/>
                                </Grid>
                            </Border>

                            <!-- CATEGORY LIST: dùng WrapPanel để không còn thanh ngang bị nhảy nhầm tab -->
                            <ScrollViewer Grid.Row="3"
                                          HorizontalScrollBarVisibility="Disabled"
                                          VerticalScrollBarVisibility="Disabled"
                                          Margin="0,0,0,16">
                                <ItemsControl ItemsSource="{Binding DanhMucs}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Height="42"
                                                    MinWidth="118"
                                                    Background="#F8FAFC"
                                                    BorderBrush="#E2E8F0"
                                                    BorderThickness="1"
                                                    Padding="18,0"
                                                    Margin="0,0,10,8"
                                                    Cursor="Hand"
                                                    Command="{Binding DataContext.ChonDanhMucCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}">
                                                <TextBlock Text="{Binding}"
                                                           VerticalAlignment="Center"
                                                           FontWeight="SemiBold"
                                                           Foreground="#334155"
                                                           TextAlignment="Center"/>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <!-- PRODUCT LIST -->
                            <ScrollViewer Grid.Row="4"
                                          VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding SanPhams}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>

                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Background="Transparent"
                                                    BorderThickness="0"
                                                    Padding="0"
                                                    Cursor="Hand"
                                                    Command="{Binding DataContext.ThemVaoGioCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}">

                                                <Border Width="220"
                                                        Height="292"
                                                        Background="#F8FAFC"
                                                        CornerRadius="24"
                                                        Padding="14"
                                                        Margin="0,0,16,16"
                                                        BorderThickness="1"
                                                        BorderBrush="#E2E8F0">

                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="122"/>
                                                            <RowDefinition Height="*"/>
                                                            <RowDefinition Height="34"/>
                                                        </Grid.RowDefinitions>

                                                        <Border Grid.Row="0"
                                                                Background="White"
                                                                CornerRadius="18"
                                                                ClipToBounds="True">
                                                            <Grid>
                                                                <TextBlock Text="☕"
                                                                           FontSize="40"
                                                                           Opacity="0.22"
                                                                           HorizontalAlignment="Center"
                                                                           VerticalAlignment="Center"/>
                                                                <Image Source="{Binding HinhAnh, Converter={StaticResource ImagePathConverter}}"
                                                                       Stretch="Uniform"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center"/>
                                                            </Grid>
                                                        </Border>

                                                        <StackPanel Grid.Row="1"
                                                                    Margin="0,12,0,0">
                                                            <TextBlock Text="{Binding TenHienThi}"
                                                                       FontSize="15"
                                                                       FontWeight="Bold"
                                                                       Foreground="#0F172A"
                                                                       TextWrapping="Wrap"
                                                                       MaxHeight="42"/>

                                                            <TextBlock Text="{Binding TenDanhMuc}"
                                                                       FontSize="12"
                                                                       Foreground="#64748B"
                                                                       Margin="0,6,0,0"/>

                                                            <TextBlock Text="{Binding GiaBanText}"
                                                                       FontSize="15"
                                                                       FontWeight="Bold"
                                                                       Foreground="#0B63F6"
                                                                       Margin="0,6,0,0"/>

                                                            <Border Background="{Binding TrangThaiBackground}"
                                                                    CornerRadius="10"
                                                                    Padding="8,4"
                                                                    HorizontalAlignment="Left"
                                                                    Margin="0,8,0,0">
                                                                <TextBlock Text="{Binding TrangThaiText}"
                                                                           FontSize="12"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="{Binding TrangThaiColor}"/>
                                                            </Border>
                                                        </StackPanel>

                                                        <Grid Grid.Row="2">
                                                            <TextBlock Text="Thêm vào bill"
                                                                       Foreground="#0B63F6"
                                                                       FontWeight="SemiBold"
                                                                       FontSize="13"
                                                                       VerticalAlignment="Center"/>

                                                            <TextBlock Text="›"
                                                                       HorizontalAlignment="Right"
                                                                       Foreground="#0B63F6"
                                                                       FontSize="22"
                                                                       FontWeight="Bold"
                                                                       VerticalAlignment="Center"/>
                                                        </Grid>
                                                    </Grid>
                                                </Border>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <!-- RIGHT: CURRENT BILL -->
                    <Border Grid.Column="1"
                            IsEnabled="{Binding DangLapHoaDon}"
                            Background="White"
                            CornerRadius="26"
                            Padding="20">

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0">
                                <DockPanel>
                                    <TextBlock Text="Hóa đơn hiện tại"
                                               FontSize="24"
                                               FontWeight="Bold"
                                               Foreground="#0F172A"
                                               DockPanel.Dock="Left"/>

                                    <Border Background="#EFF6FF"
                                            CornerRadius="13"
                                            Padding="10,5"
                                            DockPanel.Dock="Right">
                                        <TextBlock Text="{Binding LoaiHoaDonText}"
                                                   Foreground="#0B63F6"
                                                   FontWeight="SemiBold"
                                                   FontSize="12"/>
                                    </Border>
                                </DockPanel>

                                <TextBlock Text="{Binding TenBanDangChon}"
                                           FontSize="12"
                                           Foreground="#64748B"
                                           Margin="0,8,0,0"/>

                                <TextBlock Text="{Binding TenKhachHangDangChon}"
                                           FontSize="12"
                                           Foreground="#64748B"
                                           Margin="0,3,0,14"/>
                            </StackPanel>

                            <ScrollViewer Grid.Row="1"
                                          VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding GioHang}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#F8FAFC"
                                                    BorderBrush="#E2E8F0"
                                                    BorderThickness="1"
                                                    CornerRadius="18"
                                                    Padding="12"
                                                    Margin="0,0,0,10">

                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>

                                                    <DockPanel Grid.Row="0">
                                                        <StackPanel DockPanel.Dock="Left">
                                                            <TextBlock Text="{Binding TenHienThi}"
                                                                       FontWeight="Bold"
                                                                       Foreground="#0F172A"
                                                                       TextWrapping="Wrap"/>
                                                            <TextBlock Text="{Binding DonGiaText}"
                                                                       Foreground="#64748B"
                                                                       FontSize="12"
                                                                       Margin="0,4,0,0"/>

                                                            <Border Background="{Binding TrangThaiMonBackground}"
                                                                    CornerRadius="10"
                                                                    Padding="8,3"
                                                                    HorizontalAlignment="Left"
                                                                    Margin="0,6,0,0">
                                                                <TextBlock Text="{Binding TrangThaiMonText}"
                                                                           Foreground="{Binding TrangThaiMonColor}"
                                                                           FontSize="11"
                                                                           FontWeight="SemiBold"/>
                                                            </Border>
                                                        </StackPanel>

                                                        <TextBlock Text="{Binding ThanhTienText}"
                                                                   FontWeight="Bold"
                                                                   Foreground="#0B63F6"
                                                                   DockPanel.Dock="Right"/>
                                                    </DockPanel>

                                                    <Border Grid.Row="1"
                                                            Height="32"
                                                            Margin="0,10,0,8"
                                                            Background="White"
                                                            CornerRadius="10">
                                                        <TextBox Text="{Binding GhiChu, UpdateSourceTrigger=PropertyChanged}"
                                                                 Tag="Ghi chú món..."
                                                                 Style="{StaticResource WatermarkTextBox}"/>
                                                    </Border>

                                                    <StackPanel Grid.Row="2"
                                                                Orientation="Horizontal"
                                                                HorizontalAlignment="Right">
                                                        <Button Content="-"
                                                                Width="30"
                                                                Height="28"
                                                                Command="{Binding DataContext.GiamSoLuongCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}"/>

                                                        <TextBlock Text="{Binding SoLuong}"
                                                                   Width="34"
                                                                   TextAlignment="Center"
                                                                   VerticalAlignment="Center"
                                                                   FontWeight="Bold"/>

                                                        <Button Content="+"
                                                                Width="30"
                                                                Height="28"
                                                                Command="{Binding DataContext.TangSoLuongCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}"/>

                                                        <Button Content="x"
                                                                Width="30"
                                                                Height="28"
                                                                Margin="8,0,0,0"
                                                                Background="#FEE2E2"
                                                                Foreground="#DC2626"
                                                                BorderThickness="0"
                                                                Command="{Binding DataContext.XoaDongCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <StackPanel Grid.Row="2">
                                <TextBlock Text="{Binding GoiYTrangThaiBill}"
                                           Foreground="#64748B"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,10"/>

                                <Border Height="1"
                                        Background="#E2E8F0"
                                        Margin="0,12"/>

                                <Grid Margin="0,0,0,12">
                                    <TextBlock Text="Tổng tiền"
                                               FontSize="16"
                                               FontWeight="Bold"
                                               Foreground="#0F172A"/>

                                    <TextBlock Text="{Binding TongTienText}"
                                               FontSize="24"
                                               FontWeight="Bold"
                                               Foreground="#0B63F6"
                                               HorizontalAlignment="Right"/>
                                </Grid>

                                <TextBlock Text="{Binding ThongBao}"
                                           Foreground="#0B63F6"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,12"/>

                                <Button Content="Gửi pha chế"
                                        Style="{StaticResource DarkButton}"
                                        Height="48"
                                        IsEnabled="{Binding CanThaoTacBill}"
                                        Command="{Binding GuiPhaCheCommand}"/>

                                <Button Content="Thanh toán ngay"
                                        Style="{StaticResource PrimaryButton}"
                                        Height="48"
                                        Margin="0,10,0,0"
                                        IsEnabled="{Binding CanThaoTacBill}"
                                        Command="{Binding MoThanhToanCommand}"/>

                                <Button Content="Reset bill"
                                        Style="{StaticResource LightButton}"
                                        Margin="0,10,0,0"
                                        Command="{Binding LamMoiCommand}"/>
                            </StackPanel>
                        </Grid>
                    </Border>


                    <!-- MÀN HÌNH KHỞI TẠO HÓA ĐƠN -->
                    <Grid Grid.ColumnSpan="2"
                          Background="#CCF6F8FC"
                          Visibility="{Binding ChuaLapHoaDon, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Border Width="520"
                                Background="White"
                                CornerRadius="30"
                                Padding="34"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                            <StackPanel HorizontalAlignment="Center">
                                <Border Width="76"
                                        Height="76"
                                        Background="#EFF6FF"
                                        CornerRadius="26"
                                        Margin="0,0,0,18">
                                    <TextBlock Text="🧾"
                                               FontSize="36"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>

                                <TextBlock Text="Chưa có hóa đơn đang lập"
                                           FontSize="26"
                                           FontWeight="Bold"
                                           Foreground="#0F172A"
                                           TextAlignment="Center"/>

                                <TextBlock Text="Bấm Tạo hóa đơn mới rồi chọn hình thức, bàn/khách hàng và món. POS sẽ kiểm tra nguyên liệu trước khi thêm món vào bill."
                                           FontSize="14"
                                           Foreground="#64748B"
                                           TextWrapping="Wrap"
                                           TextAlignment="Center"
                                           Width="410"
                                           Margin="0,10,0,24"/>

                                <Button Content="+ Tạo hóa đơn mới"
                                        Width="220"
                                        Height="50"
                                        Style="{StaticResource PrimaryButton}"
                                        Command="{Binding TaoHoaDonMoiCommand}"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- POPUP CHỌN BÀN -->
                    <Grid Grid.ColumnSpan="2"
                          Background="#80000000"
                          Visibility="{Binding HienPopupBan, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Border Width="720"
                                Height="520"
                                Background="White"
                                CornerRadius="28"
                                Padding="24"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <DockPanel Grid.Row="0">
                                    <TextBlock Text="Chọn bàn"
                                               FontSize="26"
                                               FontWeight="Bold"
                                               Foreground="#0F172A"
                                               DockPanel.Dock="Left"/>
                                    <Button Content="Đóng"
                                            Width="90"
                                            Style="{StaticResource LightButton}"
                                            DockPanel.Dock="Right"
                                            Command="{Binding DongPopupCommand}"/>
                                </DockPanel>

                                <Border Grid.Row="1"
                                        Height="42"
                                        Background="#F8FAFC"
                                        CornerRadius="16"
                                        Padding="12,0"
                                        Margin="0,18,0,14">
                                    <TextBox Text="{Binding TuKhoaBan, UpdateSourceTrigger=PropertyChanged}"
                                             Tag="Tìm theo tên bàn hoặc mã bàn..."
                                             Style="{StaticResource WatermarkTextBox}"/>
                                </Border>

                                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding DanhSachBanTheoKhuVuc}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="0,0,0,18">
                                                    <TextBlock Text="{Binding TenKhuVuc}"
                                                               FontSize="18"
                                                               FontWeight="Bold"
                                                               Foreground="#0F172A"
                                                               Margin="0,0,0,10"/>
                                                    <ItemsControl ItemsSource="{Binding BanTrongKhuVuc}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <UniformGrid Columns="3"/>
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Button Height="118"
                                                                        Margin="0,0,12,12"
                                                                        Background="Transparent"
                                                                        BorderThickness="0"
                                                                        Padding="0"
                                                                        Cursor="Hand"
                                                                        Command="{Binding DataContext.ChonBanCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                        CommandParameter="{Binding}">
                                                                    <Border Background="{Binding TrangThaiBackground}"
                                                                            BorderBrush="{Binding TrangThaiColor}"
                                                                            BorderThickness="1"
                                                                            CornerRadius="18"
                                                                            Padding="14">
                                                                        <Grid>
                                                                            <Grid.RowDefinitions>
                                                                                <RowDefinition Height="Auto"/>
                                                                                <RowDefinition Height="Auto"/>
                                                                                <RowDefinition Height="*"/>
                                                                            </Grid.RowDefinitions>

                                                                            <TextBlock Grid.Row="0"
                                                                                       Text="{Binding TenBan}"
                                                                                       FontSize="16"
                                                                                       FontWeight="Bold"
                                                                                       Foreground="#0F172A"
                                                                                       TextTrimming="CharacterEllipsis"/>

                                                                            <TextBlock Grid.Row="1"
                                                                                       Text="{Binding MaCodeBan}"
                                                                                       FontSize="12"
                                                                                       Foreground="#64748B"
                                                                                       Margin="0,5,0,0"/>

                                                                            <DockPanel Grid.Row="2" VerticalAlignment="Bottom">
                                                                                <TextBlock Text="{Binding SoGhe, StringFormat={}{0} ghế}"
                                                                                           Foreground="#64748B"
                                                                                           FontSize="12"
                                                                                           DockPanel.Dock="Left"/>
                                                                                <Border Background="White"
                                                                                        CornerRadius="11"
                                                                                        Padding="8,4"
                                                                                        DockPanel.Dock="Right">
                                                                                    <TextBlock Text="{Binding TrangThaiText}"
                                                                                               Foreground="{Binding TrangThaiColor}"
                                                                                               FontSize="11"
                                                                                               FontWeight="SemiBold"/>
                                                                                </Border>
                                                                            </DockPanel>
                                                                        </Grid>
                                                                    </Border>
                                                                </Button>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- POPUP CHỌN KHÁCH -->
                    <Grid Grid.ColumnSpan="2"
                          Background="#80000000"
                          Visibility="{Binding HienPopupKhachHang, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Border Width="760"
                                Height="560"
                                Background="White"
                                CornerRadius="28"
                                Padding="24"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <DockPanel Grid.Row="0">
                                    <TextBlock Text="Chọn khách hàng"
                                               FontSize="26"
                                               FontWeight="Bold"
                                               Foreground="#0F172A"
                                               DockPanel.Dock="Left"/>
                                    <Button Content="Đóng"
                                            Width="90"
                                            Style="{StaticResource LightButton}"
                                            DockPanel.Dock="Right"
                                            Command="{Binding DongPopupCommand}"/>
                                </DockPanel>

                                <Border Grid.Row="1"
                                        Height="42"
                                        Background="#F8FAFC"
                                        CornerRadius="16"
                                        Padding="12,0"
                                        Margin="0,18,0,14">
                                    <TextBox Text="{Binding TuKhoaKhachHang, UpdateSourceTrigger=PropertyChanged}"
                                             Tag="Tìm khách theo tên, SĐT hoặc mã..."
                                             Style="{StaticResource WatermarkTextBox}"/>
                                </Border>

                                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding DanhSachKhachHang}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Background="Transparent"
                                                        BorderThickness="0"
                                                        Padding="0"
                                                        Margin="0,0,0,10"
                                                        Command="{Binding DataContext.ChonKhachHangCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}">
                                                    <Border Background="#F8FAFC"
                                                            BorderBrush="#E2E8F0"
                                                            BorderThickness="1"
                                                            CornerRadius="18"
                                                            Padding="14">
                                                        <DockPanel>
                                                            <TextBlock Text="👤"
                                                                       FontSize="22"
                                                                       DockPanel.Dock="Left"
                                                                       Margin="0,0,12,0"/>
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding HoTen}"
                                                                           FontWeight="Bold"
                                                                           FontSize="15"
                                                                           Foreground="#0F172A"/>
                                                                <TextBlock Text="{Binding SoDienThoai}"
                                                                           FontSize="12"
                                                                           Foreground="#64748B"
                                                                           Margin="0,4,0,0"/>
                                                            </StackPanel>
                                                        </DockPanel>
                                                    </Border>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>

                                <Button Grid.Row="3"
                                        Content="Dùng khách lẻ"
                                        Style="{StaticResource LightButton}"
                                        Margin="0,14,0,0"
                                        Command="{Binding BoChonKhachHangCommand}"/>
                            </Grid>
                        </Border>
                    </Grid>

                </Grid>
            </TabItem>

            <!-- TAB 2: LỊCH SỬ HÓA ĐƠN -->
            <TabItem Header="Lịch sử hóa đơn">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="White" CornerRadius="24" Padding="18" Margin="0,0,0,14">
                        <DockPanel LastChildFill="False">
                            <TextBlock Text="Lịch sử hóa đơn" FontSize="28" FontWeight="Bold" Foreground="#0F172A" DockPanel.Dock="Left"/>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <DatePicker SelectedDate="{Binding TuNgay, Mode=TwoWay}" Width="135" Height="42" Margin="0,0,8,0"/>
                                <DatePicker SelectedDate="{Binding DenNgay, Mode=TwoWay}" Width="135" Height="42" Margin="0,0,8,0"/>
                                <Button Content="Hôm nay" Width="90" Style="{StaticResource LightButton}" Margin="0,0,8,0" Command="{Binding ChonHomNayCommand}"/>
                                <Button Content="↻" Width="46" Style="{StaticResource PrimaryButton}" Command="{Binding LamMoiLichSuCommand}"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <Grid Grid.Row="1" Margin="0,0,0,14">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Background="White" CornerRadius="22" Padding="14" Margin="0,0,0,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="210"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Height="42" Background="#F8FAFC" CornerRadius="16" Padding="12,0" Margin="0,0,10,0">
                                    <TextBox Text="{Binding TuKhoaHoaDon, UpdateSourceTrigger=PropertyChanged}"
                                             Tag="Tìm mã hóa đơn, bàn, khách hàng..."
                                             Style="{StaticResource WatermarkTextBox}"/>
                                </Border>
                                <ComboBox Grid.Column="1" Height="42" ItemsSource="{Binding TrangThaiHoaDonFilters}" SelectedItem="{Binding TrangThaiHoaDonDangChon, Mode=TwoWay}"/>
                            </Grid>
                        </Border>

                        <UniformGrid Grid.Row="1" Columns="4">
                            <Border Background="White" CornerRadius="20" Padding="16" Margin="0,0,10,0">
                                <StackPanel>
                                    <TextBlock Text="Tổng bill" FontSize="12" Foreground="#64748B"/>
                                    <TextBlock Text="{Binding TongHoaDonText, Mode=OneWay}" FontSize="22" FontWeight="Bold" Foreground="#0F172A" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Background="#EFF6FF" CornerRadius="20" Padding="16" Margin="0,0,10,0">
                                <StackPanel>
                                    <TextBlock Text="Doanh thu" FontSize="12" Foreground="#1D4ED8"/>
                                    <TextBlock Text="{Binding TongDoanhThuText, Mode=OneWay}" FontSize="20" FontWeight="Bold" Foreground="#0B63F6" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Background="#DCFCE7" CornerRadius="20" Padding="16" Margin="0,0,10,0">
                                <StackPanel>
                                    <TextBlock Text="Đã thanh toán" FontSize="12" Foreground="#166534"/>
                                    <TextBlock Text="{Binding TongDaThanhToan, Mode=OneWay}" FontSize="22" FontWeight="Bold" Foreground="#16A34A" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Background="#FEF3C7" CornerRadius="20" Padding="16">
                                <StackPanel>
                                    <TextBlock Text="Chưa thanh toán" FontSize="12" Foreground="#92400E"/>
                                    <TextBlock Text="{Binding TongChuaThanhToan, Mode=OneWay}" FontSize="22" FontWeight="Bold" Foreground="#D97706" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                    </Grid>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="420"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="White" CornerRadius="24" Padding="18" Margin="0,0,14,0">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding DanhSachHoaDon}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Height="96" Background="Transparent" BorderThickness="0" Padding="0" Margin="0,0,0,12" Cursor="Hand" Command="{Binding DataContext.ChonHoaDonCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                                <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="18" Padding="14">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="150"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="160"/>
                                                            <ColumnDefinition Width="130"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0">
                                                            <TextBlock Text="{Binding MaHoaDonHienThi}" FontWeight="Bold" FontSize="15" Foreground="#0F172A"/>
                                                            <TextBlock Text="{Binding NgayLapText}" FontSize="12" Foreground="#64748B" Margin="0,5,0,0"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding LoaiHoaDonText}" FontWeight="Bold" Foreground="#0F172A"/>
                                                            <TextBlock Text="{Binding TenKhachHang}" FontSize="12" Foreground="#64748B" Margin="0,4,0,0"/>
                                                        </StackPanel>
                                                        <Border Grid.Column="2" Background="{Binding TrangThaiBackground}" CornerRadius="12" Padding="10,5" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding TrangThaiText}" Foreground="{Binding TrangThaiColor}" FontWeight="SemiBold" FontSize="12"/>
                                                        </Border>
                                                        <StackPanel Grid.Column="3" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding TongTienText}" FontWeight="Bold" Foreground="#0B63F6" HorizontalAlignment="Right"/>
                                                            <TextBlock Text="{Binding TongSoMonText}" FontSize="12" Foreground="#64748B" HorizontalAlignment="Right" Margin="0,4,0,0"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>

                        <Border Grid.Column="1" Background="White" CornerRadius="24" Padding="18">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0">
                                    <TextBlock Text="Chi tiết hóa đơn" FontSize="23" FontWeight="Bold" Foreground="#0F172A"/>
                                    <DockPanel Margin="0,8,0,0">
                                        <TextBlock Text="{Binding HoaDonDangChon.MaHoaDonHienThi}"
                                                   FontSize="16"
                                                   FontWeight="Bold"
                                                   Foreground="#0B63F6"
                                                   DockPanel.Dock="Left"/>
                                        <Border Background="{Binding HoaDonDangChon.TrangThaiBackground}"
                                                CornerRadius="11"
                                                Padding="8,3"
                                                HorizontalAlignment="Right"
                                                DockPanel.Dock="Right">
                                            <TextBlock Text="{Binding HoaDonDangChon.TrangThaiText}"
                                                       Foreground="{Binding HoaDonDangChon.TrangThaiColor}"
                                                       FontWeight="SemiBold"
                                                       FontSize="11"/>
                                        </Border>
                                    </DockPanel>
                                    <TextBlock Text="{Binding HoaDonDangChon.NgayLapText}" FontSize="12" Foreground="#64748B" Margin="0,4,0,12"/>
                                </StackPanel>

                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding ChiTietHoaDonDangChon}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#F8FAFC" CornerRadius="16" Padding="12" Margin="0,0,0,10">
                                                    <StackPanel>
                                                        <DockPanel>
                                                            <TextBlock Text="{Binding TenHienThi}" FontWeight="Bold" Foreground="#0F172A" TextWrapping="Wrap" DockPanel.Dock="Left"/>
                                                            <TextBlock Text="{Binding ThanhTienText}" FontWeight="Bold" Foreground="#0B63F6" DockPanel.Dock="Right"/>
                                                        </DockPanel>
                                                        <TextBlock Text="{Binding SoLuongText}" FontSize="12" Foreground="#64748B" Margin="0,5,0,0"/>
                                                        <Border Background="{Binding TrangThaiMonBackground}" CornerRadius="10" Padding="8,3" HorizontalAlignment="Left" Margin="0,6,0,0">
                                                            <TextBlock Text="{Binding TrangThaiMonText}" FontSize="12" Foreground="{Binding TrangThaiMonColor}" FontWeight="SemiBold"/>
                                                        </Border>
                                                        <TextBlock Text="{Binding GhiChu}" FontSize="12" Foreground="#64748B" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>

                                <StackPanel Grid.Row="2" Margin="0,14,0,0">
                                    <Grid Margin="0,0,0,12">
                                        <TextBlock Text="Tổng tiền" FontWeight="Bold" Foreground="#0F172A"/>
                                        <TextBlock Text="{Binding HoaDonDangChon.TongTienText}" FontSize="20" FontWeight="Bold" Foreground="#0B63F6" HorizontalAlignment="Right"/>
                                    </Grid>

                                    <TextBlock Text="{Binding GhiChuHuyHoaDonDangChon}"
                                               FontSize="12"
                                               Foreground="#64748B"
                                               TextWrapping="Wrap"
                                               Margin="0,0,0,10"/>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Content="Thanh toán ngay" Height="48" Style="{StaticResource PrimaryButton}" Command="{Binding ThanhToanHoaDonDangChonCommand}" IsEnabled="{Binding CoTheThanhToanHoaDonDangChon}"/>
                                        <Button Grid.Column="2" Content="In hóa đơn" Height="48" Style="{StaticResource LightButton}" Command="{Binding InHoaDonDangChonCommand}"/>
                                        <Button Grid.Column="4" Content="Hủy bill" Height="48" Style="{StaticResource DangerButton}" Command="{Binding HuyHoaDonDangChonCommand}" IsEnabled="{Binding CoTheHuyHoaDonDangChon}" ToolTip="{Binding GhiChuHuyHoaDonDangChon}"/>
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- POPUP THANH TOÁN DÙNG CHUNG CHO CẢ 2 TAB -->
        <Grid
                          Background="#80000000"
                          Visibility="{Binding HienPopupThanhToan, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Border Width="440"
                                Background="White"
                                CornerRadius="28"
                                Padding="24"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,18">
                                    <TextBlock Text="{Binding TieuDePopupThanhToan}"
                                               FontSize="26"
                                               FontWeight="Bold"
                                               Foreground="#0F172A"
                                               DockPanel.Dock="Left"/>
                                    <Button Content="Đóng"
                                            Width="80"
                                            Style="{StaticResource LightButton}"
                                            DockPanel.Dock="Right"
                                            Command="{Binding DongPopupCommand}"/>
                                </DockPanel>

                                <Border Background="#F8FAFC" CornerRadius="20" Padding="16" Margin="0,0,0,14">
                                    <Grid>
                                        <TextBlock Text="Tổng tiền" FontWeight="Bold" Foreground="#0F172A"/>
                                        <TextBlock Text="{Binding TongTienThanhToanPopupText}" FontSize="24" FontWeight="Bold" Foreground="#0B63F6" HorizontalAlignment="Right"/>
                                    </Grid>
                                </Border>

                                <TextBlock Text="Phương thức" FontWeight="SemiBold" Foreground="#334155"/>
                                <ComboBox ItemsSource="{Binding PaymentMethods}"
                                          SelectedItem="{Binding PhuongThucThanhToan, Mode=TwoWay}"
                                          Height="42"
                                          Margin="0,6,0,14"/>

                                <TextBlock Text="Tiền khách trả" FontWeight="SemiBold" Foreground="#334155"/>
                                <Border Height="42" Margin="0,6,0,14" Background="#F8FAFC" CornerRadius="14">
                                    <TextBox Text="{Binding TienKhachTra, UpdateSourceTrigger=PropertyChanged}"
                                             Tag="Nhập tiền khách trả..."
                                             Style="{StaticResource WatermarkTextBox}"/>
                                </Border>

                                <Grid Margin="0,0,0,16">
                                    <TextBlock Text="Tiền thừa" FontWeight="Bold" Foreground="#0F172A"/>
                                    <TextBlock Text="{Binding TienThuaText}" FontSize="18" FontWeight="Bold" Foreground="#16A34A" HorizontalAlignment="Right"/>
                                </Grid>

                                <Button Content="Xác nhận thanh toán"
                                        Style="{StaticResource PrimaryButton}"
                                        Height="48"
                                        Command="{Binding XacNhanThanhToanCommand}"/>
                            </StackPanel>
                        </Border>
                    </Grid>


        <!-- POPUP THÔNG BÁO ĐẸP -->
        <Grid Background="#80000000"
              Visibility="{Binding HienPopupThongBao, Converter={StaticResource BoolToVisibilityConverter}}">
            <Border Width="460"
                    Background="White"
                    CornerRadius="28"
                    Padding="26"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel>
                    <Border Width="64"
                            Height="64"
                            Background="#FEF3C7"
                            CornerRadius="22"
                            HorizontalAlignment="Center"
                            Margin="0,0,0,16">
                        <TextBlock Text="{Binding IconThongBao}"
                                   FontSize="32"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <TextBlock Text="{Binding TieuDeThongBao}"
                               FontSize="24"
                               FontWeight="Bold"
                               Foreground="#0F172A"
                               TextAlignment="Center"/>

                    <TextBlock Text="{Binding NoiDungThongBao}"
                               FontSize="14"
                               Foreground="#64748B"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               Margin="0,10,0,24"/>

                    <Button Content="Đã hiểu"
                            Height="46"
                            Style="{StaticResource PrimaryButton}"
                            Command="{Binding DongThongBaoCommand}"/>
                </StackPanel>
            </Border>
        </Grid>

    </Grid>
</UserControl>
