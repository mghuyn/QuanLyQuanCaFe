<UserControl x:Class="QuanLyQuanCaFe.Views.Pages.UCEmployeeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F6F8FC">

    <UserControl.Resources>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="24"/>
            <Setter Property="Padding" Value="18"/>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Background" Value="#0B63F6"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="LightButton" TargetType="Button">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="DangerButton" TargetType="Button">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Background" Value="#FEE2E2"/>
            <Setter Property="Foreground" Value="#DC2626"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="380"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT -->
        <Border Grid.Column="0"
                Style="{StaticResource CardStyle}"
                Margin="0,0,14,0">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- HEADER -->
                <DockPanel Grid.Row="0"
                           LastChildFill="False">

                    <TextBlock Text="Nhân viên"
                               FontSize="28"
                               FontWeight="Bold"
                               Foreground="#0F172A"
                               VerticalAlignment="Center"
                               DockPanel.Dock="Left"/>

                    <StackPanel Orientation="Horizontal"
                                DockPanel.Dock="Right">

                        <Button Content="+ Thêm nhân viên"
                                Width="150"
                                Style="{StaticResource PrimaryButton}"
                                Margin="0,0,8,0"
                                Command="{Binding ThemMoiCommand}"/>

                        <Button Content="↻"
                                Width="44"
                                Style="{StaticResource LightButton}"
                                Command="{Binding LamMoiCommand}"/>
                    </StackPanel>
                </DockPanel>

                <!-- FILTER -->
                <Border Grid.Row="1"
                        Background="#F8FAFC"
                        CornerRadius="20"
                        Padding="14"
                        Margin="0,16,0,14">

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="160"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Height="42"
                                Background="White"
                                CornerRadius="14"
                                Padding="12,0"
                                Margin="0,0,10,0">

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="🔍"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Center"/>

                                <TextBox Grid.Column="1"
                                         Text="{Binding TuKhoa, UpdateSourceTrigger=PropertyChanged}"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         VerticalContentAlignment="Center"
                                         Padding="6,0,0,0"
                                         FontSize="13"/>
                            </Grid>
                        </Border>

                        <ComboBox Grid.Column="1"
                                  Height="42"
                                  Margin="0,0,10,0"
                                  ItemsSource="{Binding ChucVuFilters}"
                                  SelectedItem="{Binding ChucVuDangChon, Mode=TwoWay}"/>

                        <ComboBox Grid.Column="2"
                                  Height="42"
                                  ItemsSource="{Binding TrangThaiFilters}"
                                  SelectedItem="{Binding TrangThaiDangChon, Mode=TwoWay}"/>
                    </Grid>
                </Border>

                <!-- SUMMARY -->
                <UniformGrid Grid.Row="2"
                             Columns="4"
                             Margin="0,0,0,14">

                    <Border Background="#F8FAFC"
                            CornerRadius="20"
                            Padding="16"
                            Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock Text="Tổng"
                                       FontSize="12"
                                       Foreground="#64748B"/>
                            <TextBlock Text="{Binding TongNhanVien, Mode=OneWay}"
                                       FontSize="22"
                                       FontWeight="Bold"
                                       Foreground="#0F172A"
                                       Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Background="#DCFCE7"
                            CornerRadius="20"
                            Padding="16"
                            Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock Text="Đang làm"
                                       FontSize="12"
                                       Foreground="#166534"/>
                            <TextBlock Text="{Binding DangLam, Mode=OneWay}"
                                       FontSize="22"
                                       FontWeight="Bold"
                                       Foreground="#16A34A"
                                       Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Background="#FEE2E2"
                            CornerRadius="20"
                            Padding="16"
                            Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock Text="Đã nghỉ"
                                       FontSize="12"
                                       Foreground="#991B1B"/>
                            <TextBlock Text="{Binding DaNghi, Mode=OneWay}"
                                       FontSize="22"
                                       FontWeight="Bold"
                                       Foreground="#DC2626"
                                       Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Background="#EFF6FF"
                            CornerRadius="20"
                            Padding="16">
                        <StackPanel>
                            <TextBlock Text="Tổng lương"
                                       FontSize="12"
                                       Foreground="#1D4ED8"/>
                            <TextBlock Text="{Binding TongLuongText, Mode=OneWay}"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Foreground="#0B63F6"
                                       TextTrimming="CharacterEllipsis"
                                       Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <!-- LIST -->
                <ScrollViewer Grid.Row="3"
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">

                    <ItemsControl ItemsSource="{Binding DanhSachNhanVien}">
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Background="Transparent"
                                        BorderThickness="0"
                                        Padding="0"
                                        Margin="0,0,0,12"
                                        Cursor="Hand"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Stretch"
                                        Command="{Binding DataContext.ChonNhanVienCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}">

                                    <Border HorizontalAlignment="Stretch" Background="#F8FAFC"
                                            BorderBrush="#E2E8F0"
                                            BorderThickness="1"
                                            CornerRadius="20"
                                            Padding="14"
                                            Height="96">

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="58"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="160"/>
                                                <ColumnDefinition Width="140"/>
                                            </Grid.ColumnDefinitions>

                                            <Border Width="46"
                                                    Height="46"
                                                    Background="White"
                                                    CornerRadius="15">
                                                <TextBlock Text="👨‍💼"
                                                           FontSize="20"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           Opacity="0.6"/>
                                            </Border>

                                            <StackPanel Grid.Column="1"
                                                        VerticalAlignment="Center"
                                                        Margin="6,0,14,0">

                                                <TextBlock Text="{Binding HoTen}"
                                                           FontSize="16"
                                                           FontWeight="Bold"
                                                           Foreground="#0F172A"
                                                           TextTrimming="CharacterEllipsis"/>

                                                <StackPanel Orientation="Horizontal"
                                                            Margin="0,5,0,0">
                                                    <TextBlock Text="{Binding MaNhanVien}"
                                                               FontSize="12"
                                                               Foreground="#64748B"/>
                                                    <TextBlock Text=" • "
                                                               FontSize="12"
                                                               Foreground="#64748B"/>
                                                    <TextBlock Text="{Binding SoDienThoai}"
                                                               FontSize="12"
                                                               Foreground="#64748B"/>
                                                </StackPanel>

                                                <TextBlock Text="{Binding Email}"
                                                           FontSize="12"
                                                           Foreground="#64748B"
                                                           TextWrapping="Wrap"
                                                           TextTrimming="CharacterEllipsis"
                                                           Margin="0,2,0,0"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="2"
                                                        VerticalAlignment="Center">

                                                <Border Background="{Binding ChucVuBackground}"
                                                        CornerRadius="12"
                                                        Padding="10,5"
                                                        HorizontalAlignment="Left">
                                                    <TextBlock Text="{Binding ChucVu}"
                                                               Foreground="{Binding ChucVuColor}"
                                                               FontWeight="SemiBold"
                                                               FontSize="12"/>
                                                </Border>

                                                <TextBlock Text="{Binding LuongText, Mode=OneWay}"
                                                           FontSize="13"
                                                           FontWeight="Bold"
                                                           Foreground="#0B63F6"
                                                           TextTrimming="CharacterEllipsis"
                                                           Margin="0,8,0,0"/>

                                                <TextBlock Text="{Binding NgayVaoLamText, Mode=OneWay}"
                                                           FontSize="12"
                                                           Foreground="#64748B"
                                                           Margin="0,3,0,0"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="3"
                                                        VerticalAlignment="Center"
                                                        HorizontalAlignment="Right">

                                                <Border Background="{Binding TrangThaiBackground}"
                                                        CornerRadius="12"
                                                        Padding="10,5"
                                                        HorizontalAlignment="Right">
                                                    <TextBlock Text="{Binding TrangThaiText}"
                                                               Foreground="{Binding TrangThaiColor}"
                                                               FontWeight="SemiBold"
                                                               FontSize="12"/>
                                                </Border>

                                                <TextBlock Text="{Binding GioiTinhText}"
                                                           FontSize="11"
                                                           Foreground="#64748B"
                                                           TextAlignment="Right"
                                                           HorizontalAlignment="Right"
                                                           Margin="0,8,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- RIGHT FORM -->
        <Border Grid.Column="1"
                Style="{StaticResource CardStyle}">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- FORM HEADER -->
                <StackPanel Grid.Row="0">
                    <TextBlock Text="Cập nhật"
                               FontSize="25"
                               FontWeight="Bold"
                               Foreground="#0F172A"/>

                    <Border Background="#F8FAFC"
                            CornerRadius="20"
                            Padding="14"
                            Margin="0,14,0,0">

                        <StackPanel>
                            <TextBlock Text="{Binding NhanVienDangChon.MaNhanVien}"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Foreground="#0F172A"/>

                            <TextBlock Text="{Binding NhanVienDangChon.ChucVu}"
                                       FontSize="12"
                                       Foreground="#64748B"
                                       Margin="0,4,0,0"/>

                            <TextBlock Text="{Binding NhanVienDangChon.LuongText, Mode=OneWay}"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Foreground="#0B63F6"
                                       Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- FORM BODY -->
                <ScrollViewer Grid.Row="1"
                              Margin="0,16,0,16"
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">

                    <StackPanel>
                        <TextBlock Text="Họ tên"
                                   FontWeight="SemiBold"
                                   Foreground="#334155"/>

                        <TextBox Text="{Binding NhanVienDangChon.HoTen, UpdateSourceTrigger=PropertyChanged}"
                                 Height="40"
                                 Margin="0,6,0,12"
                                 Padding="12,0"
                                 VerticalContentAlignment="Center"
                                 Background="#F8FAFC"
                                 BorderThickness="0"/>

                        <TextBlock Text="Chức vụ"
                                   FontWeight="SemiBold"
                                   Foreground="#334155"/>

                        <ComboBox ItemsSource="{Binding ChucVuGoiY}"
                                  Text="{Binding NhanVienDangChon.ChucVu, UpdateSourceTrigger=PropertyChanged}"
                                  IsEditable="True"
                                  Height="40"
                                  Margin="0,6,0,12"/>

                        <TextBlock Text="Số điện thoại"
                                   FontWeight="SemiBold"
                                   Foreground="#334155"/>

                        <TextBox Text="{Binding NhanVienDangChon.SoDienThoai, UpdateSourceTrigger=PropertyChanged}"
                                 Height="40"
                                 Margin="0,6,0,12"
                                 Padding="12,0"
                                 VerticalContentAlignment="Center"
                                 Background="#F8FAFC"
                                 BorderThickness="0"/>

                        <TextBlock Text="Email"
                                   FontWeight="SemiBold"
                                   Foreground="#334155"/>

                        <TextBox Text="{Binding NhanVienDangChon.Email, UpdateSourceTrigger=PropertyChanged}"
                                 Height="40"
                                 Margin="0,6,0,12"
                                 Padding="12,0"
                                 VerticalContentAlignment="Center"
                                 Background="#F8FAFC"
                                 BorderThickness="0"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Ngày sinh"
                                           FontWeight="SemiBold"
                                           Foreground="#334155"/>

                                <DatePicker SelectedDate="{Binding NhanVienDangChon.NgaySinh, Mode=TwoWay}"
                                            Height="40"
                                            Margin="0,6,0,12"
                                            Background="#F8FAFC"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Giới tính"
                                           FontWeight="SemiBold"
                                           Foreground="#334155"/>

                                <ComboBox ItemsSource="{Binding GioiTinhFilters}"
                                          SelectedItem="{Binding NhanVienDangChon.GioiTinh, Mode=TwoWay}"
                                          Height="40"
                                          Margin="0,6,0,12"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Ngày vào làm"
                                   FontWeight="SemiBold"
                                   Foreground="#334155"/>

                        <DatePicker SelectedDate="{Binding NhanVienDangChon.NgayVaoLam, Mode=TwoWay}"
                                    Height="40"
                                    Margin="0,6,0,12"
                                    Background="#F8FAFC"/>

                        <TextBlock Text="Lương cơ bản"
                                   FontWeight="SemiBold"
                                   Foreground="#334155"/>

                        <TextBox Text="{Binding NhanVienDangChon.LuongCoBan, UpdateSourceTrigger=PropertyChanged}"
                                 Height="40"
                                 Margin="0,6,0,12"
                                 Padding="12,0"
                                 VerticalContentAlignment="Center"
                                 Background="#F8FAFC"
                                 BorderThickness="0"/>

                        <TextBlock Text="Địa chỉ"
                                   FontWeight="SemiBold"
                                   Foreground="#334155"/>

                        <TextBox Text="{Binding NhanVienDangChon.DiaChi, UpdateSourceTrigger=PropertyChanged}"
                                 Height="58"
                                 Margin="0,6,0,12"
                                 Padding="12"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 Background="#F8FAFC"
                                 BorderThickness="0"/>

                        <TextBlock Text="Ghi chú"
                                   FontWeight="SemiBold"
                                   Foreground="#334155"/>

                        <TextBox Text="{Binding NhanVienDangChon.GhiChu, UpdateSourceTrigger=PropertyChanged}"
                                 Height="66"
                                 Margin="0,6,0,12"
                                 Padding="12"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 Background="#F8FAFC"
                                 BorderThickness="0"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- FORM ACTIONS -->
                <StackPanel Grid.Row="2">
                    <TextBlock Text="{Binding ThongBao}"
                               Foreground="#0B63F6"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"
                               Margin="0,0,0,10"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0"
                                Content="Lưu"
                                Style="{StaticResource PrimaryButton}"
                                Command="{Binding LuuCommand}"/>

                        <Button Grid.Column="2"
                                Content="Điểm danh"
                                Style="{StaticResource PrimaryButton}"
                                Command="{Binding DiemDanhCommand}"/>
                    </Grid>

                    <Button Content="Ẩn / Hiện"
                            Style="{StaticResource DangerButton}"
                            Margin="0,10,0,0"
                            Command="{Binding AnHienCommand}"/>

                    <Button Content="Reset"
                            Style="{StaticResource LightButton}"
                            Margin="0,10,0,0"
                            Command="{Binding ResetCommand}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>