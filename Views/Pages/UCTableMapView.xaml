<UserControl x:Class="QuanLyQuanCaFe.Views.Pages.UCTableMapView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:QuanLyQuanCaFe.ViewModels"
             Background="#F6F8FC">

    <UserControl.DataContext>
        <vm:TableMapViewModel/>
    </UserControl.DataContext>

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Height" Value="44"/>
            <Setter Property="Background" Value="#0B63F6"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="LightButton" TargetType="Button">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="DangerButton" TargetType="Button">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Background" Value="#FEE2E2"/>
            <Setter Property="Foreground" Value="#DC2626"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="390"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="White" CornerRadius="24" Padding="20" Margin="0,0,14,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="230"/>
                        <ColumnDefinition Width="120"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="Sơ đồ bàn" FontSize="28" FontWeight="Bold" Foreground="#0F172A"/>
                        <TextBlock Text="Bàn được nhóm theo khu vực/tầng và sắp xếp theo số thứ tự" FontSize="13" Foreground="#64748B" Margin="0,5,0,0"/>
                    </StackPanel>

                    <ComboBox Grid.Column="1" ItemsSource="{Binding KhuVucs}" SelectedItem="{Binding KhuVucDangChon}" Height="42" Margin="0,0,10,0"/>
                    <Button Grid.Column="2" Content="↻ Làm mới" Style="{StaticResource LightButton}" Command="{Binding LamMoiCommand}"/>
                </Grid>

                <UniformGrid Grid.Row="1" Columns="4" Margin="0,18,0,16">
                    <Border Background="#F8FAFC" CornerRadius="18" Padding="14" Margin="0,0,10,0"><StackPanel><TextBlock Text="Tổng bàn" Foreground="#64748B" FontSize="12"/><TextBlock Text="{Binding TongBan}" FontSize="22" FontWeight="Bold" Margin="0,6,0,0"/></StackPanel></Border>
                    <Border Background="#DCFCE7" CornerRadius="18" Padding="14" Margin="0,0,10,0"><StackPanel><TextBlock Text="Trống" Foreground="#166534" FontSize="12"/><TextBlock Text="{Binding BanTrong}" FontSize="22" FontWeight="Bold" Foreground="#16A34A" Margin="0,6,0,0"/></StackPanel></Border>
                    <Border Background="#DBEAFE" CornerRadius="18" Padding="14" Margin="0,0,10,0"><StackPanel><TextBlock Text="Đang phục vụ" Foreground="#1D4ED8" FontSize="12"/><TextBlock Text="{Binding BanDangPhucVu}" FontSize="22" FontWeight="Bold" Foreground="#2563EB" Margin="0,6,0,0"/></StackPanel></Border>
                    <Border Background="#FFEDD5" CornerRadius="18" Padding="14"><StackPanel><TextBlock Text="Cần dọn" Foreground="#C2410C" FontSize="12"/><TextBlock Text="{Binding BanCanDon}" FontSize="22" FontWeight="Bold" Foreground="#F97316" Margin="0,6,0,0"/></StackPanel></Border>
                </UniformGrid>

                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding NhomBanCafes}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,20">
                                    <DockPanel Margin="0,0,0,10">
                                        <TextBlock Text="{Binding TieuDeKhuVuc}" FontSize="18" FontWeight="Bold" Foreground="#0F172A" DockPanel.Dock="Left"/>
                                        <Border DockPanel.Dock="Right" Background="#F1F5F9" CornerRadius="12" Padding="10,4">
                                            <TextBlock Text="{Binding TongBan, StringFormat={}{0} bàn}" FontSize="12" Foreground="#64748B"/>
                                        </Border>
                                    </DockPanel>
                                    <ItemsControl ItemsSource="{Binding BanTrongKhuVuc}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Columns="3"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Command="{Binding DataContext.ChonBanCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        Padding="0"
                                                        Cursor="Hand"
                                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                                    <Border Height="150" CornerRadius="20" Padding="14" Margin="0,0,14,14" BorderThickness="2" Background="{Binding BackgroundColor}" BorderBrush="{Binding BorderColor}">
                                                        <Grid>
                                                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                                            <DockPanel Grid.Row="0">
                                                                <TextBlock Text="{Binding TenBanRutGon}" FontSize="16" FontWeight="Bold" Foreground="{Binding ForegroundColor}" TextTrimming="CharacterEllipsis" DockPanel.Dock="Left"/>
                                                                <TextBlock Text="{Binding SoGhe, StringFormat={}{0} ghế}" FontSize="11" Foreground="#475569" DockPanel.Dock="Right"/>
                                                            </DockPanel>
                                                            <StackPanel Grid.Row="1" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding TrangThaiText}" FontSize="14" FontWeight="SemiBold" Foreground="{Binding ForegroundColor}" HorizontalAlignment="Center"/>
                                                                <TextBlock Text="{Binding ThongTinBillText}" FontSize="11" Foreground="#64748B" TextAlignment="Center" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                                            </StackPanel>
                                                            <TextBlock Grid.Row="2" Text="{Binding TenKhuVucHienThi}" FontSize="11" Foreground="#64748B" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                        </Grid>
                                                    </Border>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <Border Grid.Column="1" Background="White" CornerRadius="24" Padding="20">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <TextBlock Text="Chi tiết bàn" FontSize="24" FontWeight="Bold" Foreground="#0F172A"/>
                    <TextBlock Text="Theo dõi bill, khách và thao tác chuyển trạng thái" FontSize="13" Foreground="#64748B" Margin="0,5,0,16"/>
                </StackPanel>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Border Height="112" Background="#F8FAFC" CornerRadius="20" Margin="0,0,0,16"><TextBlock Text="☕" FontSize="46" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>

                        <StackPanel DataContext="{Binding BanDangChon}">
                            <TextBlock Text="{Binding TenBan}" FontSize="24" FontWeight="Bold" Foreground="#0F172A" HorizontalAlignment="Center" TextWrapping="Wrap"/>
                            <Border Background="{Binding BackgroundColor}" CornerRadius="12" Padding="12,6" HorizontalAlignment="Center" Margin="0,8,0,18"><TextBlock Text="{Binding TrangThaiText}" Foreground="{Binding ForegroundColor}" FontWeight="Bold"/></Border>
                            <Grid Margin="0,0,0,10"><TextBlock Text="Khu vực" Foreground="#64748B"/><TextBlock Text="{Binding TenKhuVucHienThi}" HorizontalAlignment="Right" FontWeight="SemiBold"/></Grid>
                            <Grid Margin="0,0,0,10"><TextBlock Text="Số ghế" Foreground="#64748B"/><TextBlock Text="{Binding SoGhe}" HorizontalAlignment="Right" FontWeight="SemiBold"/></Grid>
                            <Grid Margin="0,0,0,10"><TextBlock Text="Trạng thái" Foreground="#64748B"/><TextBlock Text="{Binding TrangThaiText}" HorizontalAlignment="Right" FontWeight="SemiBold"/></Grid>

                            <Border Background="#F8FAFC" CornerRadius="18" Padding="14" Margin="0,12,0,0">
                                <StackPanel>
                                    <TextBlock Text="Bill đang phục vụ" FontSize="16" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,10"/>
                                    <Grid Margin="0,0,0,8"><TextBlock Text="Hóa đơn" Foreground="#64748B"/><TextBlock Text="{Binding MaHoaDonHienThi}" HorizontalAlignment="Right" FontWeight="Bold" Foreground="#0B63F6"/></Grid>
                                    <Grid Margin="0,0,0,8"><TextBlock Text="Khách" Foreground="#64748B"/><TextBlock Text="{Binding KhachDangPhucVuText}" HorizontalAlignment="Right" FontWeight="SemiBold"/></Grid>
                                    <Grid Margin="0,0,0,8"><TextBlock Text="Số món" Foreground="#64748B"/><TextBlock Text="{Binding SoMonDangPhucVu}" HorizontalAlignment="Right" FontWeight="SemiBold"/></Grid>
                                    <Grid><TextBlock Text="Tạm tính" Foreground="#64748B"/><TextBlock Text="{Binding TongTienDangPhucVuText}" HorizontalAlignment="Right" FontWeight="Bold" Foreground="#0B63F6"/></Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <Border Background="#F8FAFC" CornerRadius="18" Padding="14" Margin="0,16,0,0">
                            <StackPanel>
                                <TextBlock Text="Thêm bàn mới" FontSize="18" FontWeight="Bold" Margin="0,0,0,12"/>
                                <TextBlock Text="Tên bàn (có thể bỏ trống để tự sinh A1/B1...)" Foreground="#64748B" FontSize="12" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding TenBanMoi, UpdateSourceTrigger=PropertyChanged}" Height="40" Padding="12,0" VerticalContentAlignment="Center" BorderThickness="0" Background="White" ToolTip="Ví dụ: Bàn A1. Bỏ trống để hệ thống tự tạo theo khu vực." Margin="0,0,0,10"/>
                                <TextBlock Text="Số ghế" Foreground="#64748B" FontSize="12" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding SoGheMoi, UpdateSourceTrigger=PropertyChanged}" Height="40" Padding="12,0" VerticalContentAlignment="Center" BorderThickness="0" Background="White" ToolTip="Nhập số ghế" Margin="0,0,0,10"/>
                                <TextBox Text="{Binding GhiChuBanMoi, UpdateSourceTrigger=PropertyChanged}" Height="54" Padding="12" BorderThickness="0" Background="White" TextWrapping="Wrap" AcceptsReturn="True" ToolTip="Ghi chú bàn nếu có" Margin="0,0,0,10"/>
                                <Button Content="+ Thêm bàn" Style="{StaticResource PrimaryButton}" Command="{Binding ThemBanCommand}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <StackPanel Grid.Row="2" Margin="0,14,0,0">
                    <TextBlock Text="{Binding ThongBao}" Foreground="#0B63F6" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,10"/>
                    <Button Content="Mở bán hàng" Style="{StaticResource PrimaryButton}" Click="MoBanHang_Click" Margin="0,0,0,10" IsEnabled="{Binding CoTheMoBanHang}"/>
                    <Button Content="Chuyển bàn" Style="{StaticResource PrimaryButton}" Command="{Binding MoChuyenBanCommand}" Margin="0,0,0,10" IsEnabled="{Binding CoTheChuyenBan}"/>

                    <GroupBox Header="Cập nhật trạng thái bàn" Margin="0,0,0,10" Padding="10">
                        <StackPanel>
                            <Border Background="#FFF7ED" CornerRadius="12" Padding="10" Margin="0,0,0,10" BorderBrush="#F97316" BorderThickness="1.5">
                                <StackPanel>
                                    <CheckBox IsChecked="{Binding XacNhanHoaDonDaThanhToan, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              FontWeight="Bold"
                                              Foreground="#9A3412"
                                              FontSize="14"
                                              Content="☑ Xác nhận hóa đơn này đã được thanh toán"/>
                                    
                                </StackPanel>
                            </Border>

                            <UniformGrid Columns="2">
                                <RadioButton Content="Trống" Margin="0,4" GroupName="TrangThaiBan" IsChecked="{Binding TrangThaiLaTrong, Mode=TwoWay}" Command="{Binding DoiTrangThaiCommand}" CommandParameter="AVAILABLE"/>
                                <RadioButton Content="Đã đặt" Margin="0,4" GroupName="TrangThaiBan" IsChecked="{Binding TrangThaiDaDat, Mode=TwoWay}" Command="{Binding DoiTrangThaiCommand}" CommandParameter="RESERVED"/>
                                <RadioButton Content="Đang phục vụ" Margin="0,4" GroupName="TrangThaiBan" IsChecked="{Binding TrangThaiDangPhucVu, Mode=TwoWay}" Command="{Binding DoiTrangThaiCommand}" CommandParameter="OCCUPIED"/>
                                <RadioButton Content="Cần dọn" Margin="0,4" GroupName="TrangThaiBan" IsChecked="{Binding TrangThaiCanDon, Mode=TwoWay}" Command="{Binding DoiTrangThaiCommand}" CommandParameter="CLEANING"/>
                            </UniformGrid>
                        </StackPanel>
                    </GroupBox>

                    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Xóa bàn" Style="{StaticResource DangerButton}" Command="{Binding XoaBanCommand}"/>
                        <Button Grid.Column="2" Content="Ngưng dùng" Style="{StaticResource DangerButton}" Command="{Binding NgungDungCommand}"/>
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.ColumnSpan="2" Background="#99000000" Visibility="{Binding HienPopupChuyenBan, Converter={StaticResource BoolToVisibilityConverter}}">
            <Border Width="460" Background="White" CornerRadius="26" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="Chuyển bàn" FontSize="26" FontWeight="Bold" Foreground="#0F172A" HorizontalAlignment="Center"/>
                    <TextBlock Text="Chọn bàn trống để chuyển hóa đơn đang phục vụ sang bàn mới." Foreground="#64748B" TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,20"/>
                    <ComboBox ItemsSource="{Binding DanhSachBanTrongDeChuyen}" SelectedItem="{Binding BanChuyenDen, Mode=TwoWay}" DisplayMemberPath="TenBanRutGon" Height="44" Margin="0,0,0,16"/>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Xác nhận chuyển" Style="{StaticResource PrimaryButton}" Command="{Binding XacNhanChuyenBanCommand}"/>
                        <Button Grid.Column="2" Content="Đóng" Style="{StaticResource LightButton}" Command="{Binding DongChuyenBanCommand}"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
