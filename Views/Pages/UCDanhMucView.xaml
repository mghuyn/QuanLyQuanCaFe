<UserControl x:Class="QuanLyQuanCaFe.Views.Pages.UCDanhMucView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F6F8FC">
    <UserControl.Resources>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="24"/>
            <Setter Property="Padding" Value="18"/>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Background" Value="#0B63F6"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="LightButton" TargetType="Button">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="DangerButton" TargetType="Button">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Background" Value="#FEE2E2"/>
            <Setter Property="Foreground" Value="#DC2626"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource CardStyle}" Margin="0,0,0,14">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center"><TextBlock Text="Danh mục hệ thống" FontSize="28" FontWeight="Bold" Foreground="#0F172A"/><TextBlock Text="Quản lý dữ liệu nền: loại sản phẩm, nhà cung cấp, đơn vị tính. Các dữ liệu này được dùng lại ở sản phẩm, kho và bán hàng." FontSize="13" Foreground="#64748B" Margin="0,5,0,0"/></StackPanel>
                <Button Content="↻ Làm mới" Width="120" Style="{StaticResource LightButton}" Command="{Binding LamMoiCommand}" DockPanel.Dock="Right"/>
            </DockPanel>
        </Border>

        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0">
            <TabItem Header="Loại sản phẩm">
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="380"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,14,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="160"/>
                                    <ColumnDefinition Width="120"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding TuKhoaLoai, UpdateSourceTrigger=PropertyChanged}" Height="42" Padding="12,0" VerticalContentAlignment="Center" BorderThickness="0" Background="#F8FAFC" Margin="0,0,10,0" ToolTip="Nhập mã hoặc tên loại sản phẩm"/>
                                <ComboBox Grid.Column="1" ItemsSource="{Binding TrangThaiLoaiFilters}" SelectedItem="{Binding TrangThaiLoai, Mode=TwoWay}" Height="42" Margin="0,0,10,0"/>
                                <Button Grid.Column="2" Content="+ Thêm" Style="{StaticResource PrimaryButton}" Command="{Binding ThemMoiLoaiCommand}"/>
                            </Grid>
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding DanhSachLoaiSanPham}">
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Background="Transparent" BorderThickness="0" Padding="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Margin="0,0,0,10" Command="{Binding DataContext.ChonLoaiCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                                <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="18" Padding="14" Height="88" HorizontalAlignment="Stretch">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="120"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="130"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="{Binding MaCodeDanhMuc}" FontWeight="Bold" Foreground="#0B63F6" VerticalAlignment="Center"/>
                                                        <StackPanel Grid.Column="1">
                                                            <TextBlock Text="{Binding TenDanhMuc}" FontWeight="Bold" FontSize="15" Foreground="#0F172A" TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Text="{Binding MoTa}" FontSize="12" Foreground="#64748B" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                                        </StackPanel>
                                                        <Border Grid.Column="2" Background="{Binding TrangThaiBackground}" CornerRadius="12" Padding="10,5" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding TrangThaiText}" Foreground="{Binding TrangThaiColor}" FontWeight="SemiBold" FontSize="12"/>
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="Cập nhật loại sản phẩm" FontSize="24" FontWeight="Bold" Foreground="#0F172A"/>
                            <ScrollViewer Grid.Row="1" Margin="0,16,0,16" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel>
                                    <TextBlock Text="Mã loại" FontWeight="SemiBold"/>
                                    <TextBox Text="{Binding LoaiDangChon.MaCodeDanhMuc}" Height="40" Margin="0,6,0,12" Padding="12,0" VerticalContentAlignment="Center" Background="#F8FAFC" BorderThickness="0" IsReadOnly="True"/>
                                    <TextBlock Text="Tên loại sản phẩm" FontWeight="SemiBold"/>
                                    <TextBox Text="{Binding LoaiDangChon.TenDanhMuc, UpdateSourceTrigger=PropertyChanged}" Height="40" Margin="0,6,0,12" Padding="12,0" VerticalContentAlignment="Center" Background="#F8FAFC" BorderThickness="0"/>
                                    <TextBlock Text="Thứ tự hiển thị" FontWeight="SemiBold"/>
                                    <TextBox Text="{Binding LoaiDangChon.ThuTuHienThi, UpdateSourceTrigger=PropertyChanged}" Height="40" Margin="0,6,0,12" Padding="12,0" VerticalContentAlignment="Center" Background="#F8FAFC" BorderThickness="0"/>
                                    <TextBlock Text="Mô tả" FontWeight="SemiBold"/>
                                    <TextBox Text="{Binding LoaiDangChon.MoTa, UpdateSourceTrigger=PropertyChanged}" Height="90" Margin="0,6,0,12" Padding="12" TextWrapping="Wrap" AcceptsReturn="True" Background="#F8FAFC" BorderThickness="0"/>
                                </StackPanel>
                            </ScrollViewer>
                            <StackPanel Grid.Row="2">
                                <TextBlock Text="{Binding ThongBao}" Foreground="#0B63F6" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,10"/>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Content="Lưu" Style="{StaticResource PrimaryButton}" Command="{Binding LuuLoaiCommand}"/>
                                    <Button Grid.Column="2" Content="Ẩn / Hiện" Style="{StaticResource DangerButton}" Command="{Binding DoiTrangThaiLoaiCommand}"/>
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Nhà cung cấp">
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="410"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,14,0">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="0,0,0,14">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="170"/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding TuKhoaNCC, UpdateSourceTrigger=PropertyChanged}" Height="42" Padding="12,0" VerticalContentAlignment="Center" BorderThickness="0" Background="#F8FAFC" Margin="0,0,10,0" ToolTip="Tìm theo mã, tên, SĐT, email"/>
                                <ComboBox Grid.Column="1" ItemsSource="{Binding TrangThaiNCCFilters}" SelectedItem="{Binding TrangThaiNCC, Mode=TwoWay}" Height="42" Margin="0,0,10,0"/>
                                <Button Grid.Column="2" Content="+ Thêm" Style="{StaticResource PrimaryButton}" Command="{Binding ThemMoiNCCCommand}"/>
                            </Grid>
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding DanhSachNhaCungCap}">
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Background="Transparent" BorderThickness="0" Padding="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Margin="0,0,0,10" Command="{Binding DataContext.ChonNCCCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                                <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="18" Padding="14" Height="88" HorizontalAlignment="Stretch">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/><ColumnDefinition Width="140"/></Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="{Binding MaNhaCungCap}" FontWeight="Bold" Foreground="#0B63F6" VerticalAlignment="Center"/>
                                                        <StackPanel Grid.Column="1">
                                                            <TextBlock Text="{Binding TenNhaCungCap}" FontWeight="Bold" FontSize="15" Foreground="#0F172A" TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock FontSize="12" Foreground="#64748B" Margin="0,4,0,0"><Run Text="{Binding SoDienThoai}"/><Run Text=" • "/><Run Text="{Binding Email}"/></TextBlock>
                                                        </StackPanel>
                                                        <Border Grid.Column="2" Background="{Binding TrangThaiBackground}" CornerRadius="12" Padding="10,5" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding TrangThaiText}" Foreground="{Binding TrangThaiColor}" FontWeight="SemiBold" FontSize="12"/>
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <TextBlock Text="Cập nhật nhà cung cấp" FontSize="24" FontWeight="Bold" Foreground="#0F172A"/>
                            <ScrollViewer Grid.Row="1" Margin="0,16,0,16" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel>
                                    <TextBlock Text="Mã NCC" FontWeight="SemiBold"/>
                                    <TextBox Text="{Binding NhaCungCapDangChon.MaNhaCungCap}" Height="40" Margin="0,6,0,12" Padding="12,0" VerticalContentAlignment="Center" Background="#F8FAFC" BorderThickness="0" IsReadOnly="True"/>
                                    <TextBlock Text="Tên nhà cung cấp" FontWeight="SemiBold"/>
                                    <TextBox Text="{Binding NhaCungCapDangChon.TenNhaCungCap, UpdateSourceTrigger=PropertyChanged}" Height="40" Margin="0,6,0,12" Padding="12,0" VerticalContentAlignment="Center" Background="#F8FAFC" BorderThickness="0"/>
                                    <TextBlock Text="Người liên hệ" FontWeight="SemiBold"/>
                                    <TextBox Text="{Binding NhaCungCapDangChon.NguoiLienHe, UpdateSourceTrigger=PropertyChanged}" Height="40" Margin="0,6,0,12" Padding="12,0" VerticalContentAlignment="Center" Background="#F8FAFC" BorderThickness="0"/>
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0"><TextBlock Text="Số điện thoại" FontWeight="SemiBold"/><TextBox Text="{Binding NhaCungCapDangChon.SoDienThoai, UpdateSourceTrigger=PropertyChanged}" Height="40" Margin="0,6,0,12" Padding="12,0" VerticalContentAlignment="Center" Background="#F8FAFC" BorderThickness="0"/></StackPanel>
                                        <StackPanel Grid.Column="2"><TextBlock Text="Email" FontWeight="SemiBold"/><TextBox Text="{Binding NhaCungCapDangChon.Email, UpdateSourceTrigger=PropertyChanged}" Height="40" Margin="0,6,0,12" Padding="12,0" VerticalContentAlignment="Center" Background="#F8FAFC" BorderThickness="0"/></StackPanel>
                                    </Grid>
                                    <TextBlock Text="Địa chỉ" FontWeight="SemiBold"/>
                                    <TextBox Text="{Binding NhaCungCapDangChon.DiaChi, UpdateSourceTrigger=PropertyChanged}" Height="64" Margin="0,6,0,12" Padding="12" TextWrapping="Wrap" AcceptsReturn="True" Background="#F8FAFC" BorderThickness="0"/>
                                    <TextBlock Text="Ghi chú" FontWeight="SemiBold"/>
                                    <TextBox Text="{Binding NhaCungCapDangChon.GhiChu, UpdateSourceTrigger=PropertyChanged}" Height="70" Margin="0,6,0,12" Padding="12" TextWrapping="Wrap" AcceptsReturn="True" Background="#F8FAFC" BorderThickness="0"/>
                                </StackPanel>
                            </ScrollViewer>
                            <StackPanel Grid.Row="2"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="Lưu" Style="{StaticResource PrimaryButton}" Command="{Binding LuuNCCCommand}"/>
                                <Button Grid.Column="2" Content="Ẩn / Hiện" Style="{StaticResource DangerButton}" Command="{Binding DoiTrangThaiNCCCommand}"/>
                            </Grid></StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Đơn vị tính">
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="360"/></Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,14,0">
                        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions>
                                <TextBox Text="{Binding TuKhoaDVT, UpdateSourceTrigger=PropertyChanged}" Height="42" Padding="12,0" VerticalContentAlignment="Center" Background="#F8FAFC" BorderThickness="0" Margin="0,0,10,0" ToolTip="Tìm đơn vị tính"/>
                                <Button Grid.Column="1" Content="+ Thêm" Style="{StaticResource PrimaryButton}" Command="{Binding ThemMoiDVTCommand}"/>
                            </Grid>
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ItemsControl ItemsSource="{Binding DanhSachDonViTinh}">
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                            </Style>
                        </ItemsControl.ItemContainerStyle><ItemsControl.ItemTemplate><DataTemplate>
                                <Button Background="Transparent" BorderThickness="0" Padding="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Margin="0,0,0,10" Command="{Binding DataContext.ChonDVTCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="18" Padding="14" Height="88" HorizontalAlignment="Stretch"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding MaCodeDonVi}" FontWeight="Bold" Foreground="#0B63F6" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1"><TextBlock Text="{Binding TenDonVi}" FontWeight="Bold" FontSize="15" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding MoTa}" FontSize="12" Foreground="#64748B" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel>
                                    </Grid></Border>
                                </Button>
                            </DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
                        </Grid>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <TextBlock Text="Cập nhật đơn vị tính" FontSize="24" FontWeight="Bold"/>
                            <StackPanel Grid.Row="1" Margin="0,16,0,16"><TextBlock Text="Mã đơn vị" FontWeight="SemiBold"/><TextBox Text="{Binding DonViTinhDangChon.MaCodeDonVi}" Height="40" Margin="0,6,0,12" Padding="12,0" VerticalContentAlignment="Center" Background="#F8FAFC" BorderThickness="0" IsReadOnly="True"/>
                                <TextBlock Text="Tên đơn vị" FontWeight="SemiBold"/><TextBox Text="{Binding DonViTinhDangChon.TenDonVi, UpdateSourceTrigger=PropertyChanged}" Height="40" Margin="0,6,0,12" Padding="12,0" VerticalContentAlignment="Center" Background="#F8FAFC" BorderThickness="0"/>
                                <TextBlock Text="Mô tả" FontWeight="SemiBold"/><TextBox Text="{Binding DonViTinhDangChon.MoTa, UpdateSourceTrigger=PropertyChanged}" Height="90" Margin="0,6,0,12" Padding="12" TextWrapping="Wrap" AcceptsReturn="True" Background="#F8FAFC" BorderThickness="0"/>
                            </StackPanel>
                            <Button Grid.Row="2" Content="Lưu đơn vị tính" Style="{StaticResource PrimaryButton}" Command="{Binding LuuDVTCommand}"/>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
