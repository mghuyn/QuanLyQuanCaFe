<UserControl x:Class="QuanLyQuanCaFe.Views.Pages.UCReportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F6F8FC">

    <UserControl.Resources>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="24"/>
            <Setter Property="Padding" Value="18"/>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Background" Value="#0B63F6"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="LightButton" TargetType="Button">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0"
                Style="{StaticResource CardStyle}"
                Margin="0,0,0,14">

            <DockPanel LastChildFill="False">
                <TextBlock Text="Báo cáo"
                           FontSize="28"
                           FontWeight="Bold"
                           Foreground="#0F172A"
                           VerticalAlignment="Center"
                           DockPanel.Dock="Left"/>

                <StackPanel Orientation="Horizontal"
                            DockPanel.Dock="Right">

                    <TextBlock Text="Từ ngày"
                               VerticalAlignment="Center"
                               FontWeight="SemiBold"
                               Foreground="#334155"
                               Margin="0,0,8,0"/>

                    <DatePicker SelectedDate="{Binding TuNgay, Mode=TwoWay}"
                                Width="140"
                                Height="42"
                                Margin="0,0,12,0"/>

                    <TextBlock Text="Đến ngày"
                               VerticalAlignment="Center"
                               FontWeight="SemiBold"
                               Foreground="#334155"
                               Margin="0,0,8,0"/>

                    <DatePicker SelectedDate="{Binding DenNgay, Mode=TwoWay}"
                                Width="140"
                                Height="42"
                                Margin="0,0,12,0"/>

                    <Button Content="Hôm nay"
                            Width="90"
                            Style="{StaticResource LightButton}"
                            Margin="0,0,8,0"
                            Command="{Binding HomNayCommand}"/>

                    <Button Content="Tháng này"
                            Width="100"
                            Style="{StaticResource LightButton}"
                            Margin="0,0,8,0"
                            Command="{Binding ThangNayCommand}"/>

                    <Button Content="Xem báo cáo"
                            Width="120"
                            Style="{StaticResource PrimaryButton}"
                            Margin="0,0,8,0"
                            Command="{Binding XemBaoCaoCommand}"/>

                    <Button Content="Report nâng cao"
        Width="130"
        Style="{StaticResource PrimaryButton}"
        Command="{Binding XuatBaoCaoCommand}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <TextBlock Grid.Row="1"
                   Text="{Binding BaoCaoCapNhatText}"
                   Foreground="#0B63F6"
                   FontWeight="SemiBold"
                   Margin="4,0,0,10"/>

        <!-- SUMMARY -->
        <UniformGrid Grid.Row="2"
                     Columns="4"
                     Margin="0,0,0,14">

            <Border Background="White"
                    CornerRadius="18"
                    Padding="12"
                    Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="Doanh thu"
                               FontSize="13"
                               Foreground="#64748B"/>
                    <TextBlock Text="{Binding TongQuan.DoanhThuText, Mode=OneWay}"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="#0B63F6"
                               Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <Border Background="#F8FAFC"
                    CornerRadius="18"
                    Padding="12"
                    Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="Số hóa đơn"
                               FontSize="13"
                               Foreground="#64748B"/>
                    <TextBlock Text="{Binding TongQuan.SoHoaDonText, Mode=OneWay}"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="#0F172A"
                               Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <Border Background="#F0FDF4"
                    CornerRadius="18"
                    Padding="12"
                    Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="Sản phẩm bán ra"
                               FontSize="13"
                               Foreground="#166534"/>
                    <TextBlock Text="{Binding TongQuan.SoSanPhamBanRaText, Mode=OneWay}"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="#16A34A"
                               Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <Border Background="#FEF3C7"
                    CornerRadius="18"
                    Padding="12">
                <StackPanel>
                    <TextBlock Text="Khách hàng"
                               FontSize="13"
                               Foreground="#92400E"/>
                    <TextBlock Text="{Binding TongQuan.SoKhachHangText, Mode=OneWay}"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="#D97706"
                               Margin="0,8,0,0"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- BODY -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.25*"/>
                <ColumnDefinition Width="0.75*"/>
            </Grid.ColumnDefinitions>

            <!-- REVENUE BY DAY -->
            <Border Grid.Column="0"
                    Style="{StaticResource CardStyle}"
                    Margin="0,0,14,0">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="Doanh thu theo ngày"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="#0F172A"
                               Margin="0,0,0,16"/>

                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding DoanhThuTheoNgay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="70"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="130"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding NgayText, Mode=OneWay}"
                                                   FontWeight="SemiBold"
                                                   Foreground="#334155"
                                                   VerticalAlignment="Center"/>

                                        <Grid Grid.Column="1"
                                              Height="18"
                                              Background="#E2E8F0"
                                              VerticalAlignment="Center">
                                            <Border Width="{Binding DoRongCot}"
                                                    Background="#0B63F6"
                                                    CornerRadius="9"
                                                    HorizontalAlignment="Left"/>
                                        </Grid>

                                        <StackPanel Grid.Column="2"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DoanhThuText, Mode=OneWay}"
                                                       FontWeight="Bold"
                                                       Foreground="#0B63F6"
                                                       HorizontalAlignment="Right"/>
                                            <TextBlock Text="{Binding SoHoaDon, Mode=OneWay, StringFormat={}{0} hóa đơn}"
                                                       FontSize="11"
                                                       Foreground="#64748B"
                                                       HorizontalAlignment="Right"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <TextBlock Grid.Row="2"
                               Text="{Binding ThongBao}"
                               Foreground="#0B63F6"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"
                               Margin="0,12,0,0"/>
                </Grid>
            </Border>

            <!-- BEST SELLING -->
            <Border Grid.Column="1"
                    Style="{StaticResource CardStyle}">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="Sản phẩm bán chạy"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="#0F172A"
                               Margin="0,0,0,16"/>

                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto">

                        <ItemsControl ItemsSource="{Binding SanPhamBanChay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#F8FAFC"
                                            BorderBrush="#E2E8F0"
                                            BorderThickness="1"
                                            CornerRadius="18"
                                            Padding="14"
                                            Margin="0,0,0,12">

                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <DockPanel Grid.Row="0">
                                                <StackPanel DockPanel.Dock="Left">
                                                    <TextBlock Text="{Binding TenSanPham}"
                                                               FontSize="15"
                                                               FontWeight="Bold"
                                                               Foreground="#0F172A"
                                                               TextWrapping="Wrap"/>

                                                    <TextBlock Text="{Binding TenDanhMuc}"
                                                               FontSize="12"
                                                               Foreground="#64748B"
                                                               Margin="0,4,0,0"/>
                                                </StackPanel>

                                                <StackPanel DockPanel.Dock="Right">
                                                    <TextBlock Text="{Binding SoLuongBanText, Mode=OneWay}"
                                                               FontWeight="Bold"
                                                               Foreground="#0B63F6"
                                                               HorizontalAlignment="Right"/>

                                                    <TextBlock Text="{Binding DoanhThuText, Mode=OneWay}"
                                                               FontSize="12"
                                                               Foreground="#64748B"
                                                               HorizontalAlignment="Right"
                                                               Margin="0,4,0,0"/>
                                                </StackPanel>
                                            </DockPanel>

                                            <Grid Grid.Row="2"
                                                  Height="8"
                                                  Background="#E2E8F0"
                                                  Margin="0,12,0,0">
                                                <Border Width="{Binding DoRongCot}"
                                                        Background="#0B63F6"
                                                        CornerRadius="8"
                                                        HorizontalAlignment="Left"/>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>