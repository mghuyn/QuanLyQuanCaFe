<UserControl x:Class="QuanLyQuanCaFe.Views.Pages.UCSanPhamTestView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:QuanLyQuanCaFe.Services"
             Background="#F6F8FC">

    <UserControl.Resources>
        <converters:ImagePathConverter x:Key="ImagePathConverter"/>
    </UserControl.Resources>

    <Grid Margin="22">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="430"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT: danh sách sản phẩm -->
        <Border Grid.Column="0"
                Background="White"
                CornerRadius="28"
                Padding="22"
                Margin="0,0,18,0">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="116"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Grid Grid.Row="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="54"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <StackPanel>
                            <TextBlock Text="Sản phẩm"
                                       FontSize="28"
                                       FontWeight="Bold"
                                       Foreground="#0F172A"/>

                            <TextBlock Text="Quản lý menu món, hình ảnh, giá bán và trạng thái"
                                       FontSize="13"
                                       Foreground="#64748B"
                                       Margin="0,4,0,0"/>
                        </StackPanel>

                        <Button Content="+ Thêm sản phẩm"
                                Width="150"
                                Height="40"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Background="#0B63F6"
                                Foreground="White"
                                BorderThickness="0"
                                FontWeight="Bold"
                                Command="{Binding BatDauThemCommand}"/>
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="170"/>
                            <ColumnDefinition Width="170"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Height="44"
                                Background="#F8FAFC"
                                CornerRadius="16"
                                Padding="12,0"
                                Margin="0,0,12,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="26"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="🔍"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Center"
                                           FontSize="14"/>

                                <TextBox Grid.Column="1"
                                         Text="{Binding TuKhoa, UpdateSourceTrigger=PropertyChanged}"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         FontSize="13"
                                         Padding="6,0,0,0"
                                         VerticalContentAlignment="Center"/>
                            </Grid>
                        </Border>

                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding DanhMucs}"
                                  SelectedItem="{Binding DanhMucDangChon, Mode=TwoWay}"
                                  Height="44"
                                  Margin="0,0,10,0"/>

                        <ComboBox Grid.Column="2"
                                  ItemsSource="{Binding TrangThaiFilters}"
                                  SelectedItem="{Binding TrangThaiDangChon, Mode=TwoWay}"
                                  Height="44"/>
                    </Grid>
                </Grid>

                <!-- Cards -->
                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              Margin="0,20,0,0">
                    <ItemsControl ItemsSource="{Binding SanPhams}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Command="{Binding DataContext.ChonSanPhamCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Padding="0"
                                        Cursor="Hand">

                                    <Border Width="220"
                                            Height="292"
                                            Background="#F8FAFC"
                                            CornerRadius="24"
                                            Padding="14"
                                            Margin="0,0,16,16"
                                            BorderThickness="1"
                                            BorderBrush="#E2E8F0">

                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="122"/>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="34"/>
                                            </Grid.RowDefinitions>

                                            <Border Grid.Row="0"
                                                    Background="White"
                                                    CornerRadius="18"
                                                    ClipToBounds="True">
                                                <Image Source="{Binding HinhAnh, Converter={StaticResource ImagePathConverter}}"
                                                       Stretch="Uniform"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                            </Border>

                                            <StackPanel Grid.Row="1"
                                                        Margin="0,12,0,0">
                                                <TextBlock Text="{Binding TenSanPham}"
                                                           FontSize="15"
                                                           FontWeight="Bold"
                                                           Foreground="#0F172A"
                                                           TextWrapping="Wrap"
                                                           MaxHeight="42"/>

                                                <TextBlock Text="{Binding TenDanhMuc}"
                                                           FontSize="12"
                                                           Foreground="#64748B"
                                                           Margin="0,6,0,0"/>

                                                <TextBlock Text="{Binding GiaBanText}"
                                                           FontSize="15"
                                                           FontWeight="Bold"
                                                           Foreground="#0B63F6"
                                                           Margin="0,6,0,0"/>

                                                <Border Background="{Binding TrangThaiBackground}"
                                                        CornerRadius="10"
                                                        Padding="8,4"
                                                        HorizontalAlignment="Left"
                                                        Margin="0,8,0,0">
                                                    <TextBlock Text="{Binding TrangThaiText}"
                                                               FontSize="12"
                                                               FontWeight="SemiBold"
                                                               Foreground="{Binding TrangThaiColor}"/>
                                                </Border>
                                            </StackPanel>

                                            <Grid Grid.Row="2">
                                                <TextBlock Text="Xem chi tiết"
                                                           Foreground="#0B63F6"
                                                           FontWeight="SemiBold"
                                                           FontSize="13"
                                                           VerticalAlignment="Center"/>

                                                <TextBlock Text="›"
                                                           HorizontalAlignment="Right"
                                                           Foreground="#0B63F6"
                                                           FontSize="22"
                                                           FontWeight="Bold"
                                                           VerticalAlignment="Center"/>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- RIGHT: chi tiết / form -->
        <Border Grid.Column="1"
                Background="White"
                CornerRadius="28"
                Padding="24">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <TextBlock Text="{Binding TieuDePanel}"
                               FontSize="26"
                               FontWeight="Bold"
                               Foreground="#0F172A"/>

                    <TextBlock Text="Chọn card để xem chi tiết, hoặc bấm Thêm/Cập nhật để chỉnh sửa"
                               FontSize="13"
                               Foreground="#64748B"
                               TextWrapping="Wrap"
                               Margin="0,6,0,18"/>
                </StackPanel>

                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              Margin="0,0,0,14">
                    <StackPanel>
                        <Border Height="145"
                                Background="#F8FAFC"
                                CornerRadius="22"
                                ClipToBounds="True"
                                Margin="0,0,0,18">
                            <Image Source="{Binding DuongDanAnhDangChon, Converter={StaticResource ImagePathConverter}}"
                                   Stretch="Uniform"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                        </Border>

                        <Border Background="#F8FAFC"
                                CornerRadius="18"
                                Padding="16"
                                Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Thông tin đang chọn"
                                           FontSize="16"
                                           FontWeight="Bold"
                                           Foreground="#0F172A"/>

                                <Grid Margin="0,14,0,0">
                                    <TextBlock Text="Tên món"
                                               Foreground="#64748B"/>
                                    <TextBlock Text="{Binding SanPhamDangChon.TenSanPham}"
                                               HorizontalAlignment="Right"
                                               FontWeight="SemiBold"/>
                                </Grid>

                                <Grid Margin="0,10,0,0">
                                    <TextBlock Text="Danh mục"
                                               Foreground="#64748B"/>
                                    <TextBlock Text="{Binding SanPhamDangChon.TenDanhMuc}"
                                               HorizontalAlignment="Right"
                                               FontWeight="SemiBold"/>
                                </Grid>

                                <Grid Margin="0,10,0,0">
                                    <TextBlock Text="Giá bán"
                                               Foreground="#64748B"/>
                                    <TextBlock Text="{Binding SanPhamDangChon.GiaBanText}"
                                               HorizontalAlignment="Right"
                                               FontWeight="Bold"
                                               Foreground="#0B63F6"/>
                                </Grid>

                                <Grid Margin="0,10,0,0">
                                    <TextBlock Text="Trạng thái"
                                               Foreground="#64748B"/>
                                    <TextBlock Text="{Binding SanPhamDangChon.TrangThaiText}"
                                               HorizontalAlignment="Right"
                                               FontWeight="Bold"
                                               Foreground="{Binding SanPhamDangChon.TrangThaiColor}"/>
                                </Grid>

                                <TextBlock Text="Mô tả / thành phần"
                                           Foreground="#64748B"
                                           Margin="0,16,0,6"/>

                                <TextBlock Text="{Binding SanPhamDangChon.MoTa}"
                                           TextWrapping="Wrap"
                                           Foreground="#0F172A"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Tên sản phẩm"
                                   FontWeight="SemiBold"
                                   Foreground="#334155"/>

                        <TextBox Text="{Binding TenSanPhamNhap, UpdateSourceTrigger=PropertyChanged}"
                                 Height="42"
                                 Margin="0,8,0,14"
                                 Padding="12,0"
                                 VerticalContentAlignment="Center"/>

                        <TextBlock Text="Danh mục"
                                   FontWeight="SemiBold"
                                   Foreground="#334155"/>

                        <ComboBox ItemsSource="{Binding DanhMucs}"
                                  SelectedItem="{Binding DanhMucNhap, Mode=TwoWay}"
                                  Height="42"
                                  Margin="0,8,0,14"/>

                        <TextBlock Text="Giá bán"
                                   FontWeight="SemiBold"
                                   Foreground="#334155"/>

                        <TextBox Text="{Binding GiaBanNhap, UpdateSourceTrigger=PropertyChanged}"
                                 Height="42"
                                 Margin="0,8,0,14"
                                 Padding="12,0"
                                 VerticalContentAlignment="Center"/>

                        <TextBlock Text="Mô tả / thành phần"
                                   FontWeight="SemiBold"
                                   Foreground="#334155"/>

                        <TextBox Text="{Binding MoTaNhap, UpdateSourceTrigger=PropertyChanged}"
                                 Height="92"
                                 Margin="0,8,0,14"
                                 Padding="12"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"/>

                        <Button Content="Chọn ảnh từ máy"
                                Height="42"
                                Margin="0,0,0,12"
                                Command="{Binding ChonAnhCommand}"/>

                        <TextBlock Text="{Binding DuongDanAnhDangChon}"
                                   Foreground="#64748B"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,10"/>
                    </StackPanel>
                </ScrollViewer>

                <StackPanel Grid.Row="2">
                    <TextBlock Text="{Binding ThongBao}"
                               Foreground="#0B63F6"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"
                               Margin="0,0,0,10"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0"
                                Content="Sửa"
                                Height="44"
                                Command="{Binding BatDauSuaCommand}"/>

                        <Button Grid.Column="2"
                                Content="Ẩn / Hiện"
                                Height="44"
                                Command="{Binding DoiTrangThaiCommand}"/>
                    </Grid>

                    <Button Content="{Binding TenNutLuu}"
                            Height="46"
                            Margin="0,10,0,0"
                            Background="#0B63F6"
                            Foreground="White"
                            FontWeight="Bold"
                            BorderThickness="0"
                            Command="{Binding LuuCommand}"/>

                    <Button Content="Reset"
                            Height="44"
                            Margin="0,10,0,0"
                            Command="{Binding ResetCommand}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>