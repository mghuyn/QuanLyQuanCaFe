<UserControl x:Class="QuanLyQuanCaFe.Views.Pages.UCKitchenView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:QuanLyQuanCaFe.ViewModels"
             Background="#F6F8FC">

    <UserControl.DataContext>
        <vm:KitchenViewModel/>
    </UserControl.DataContext>

    <UserControl.Resources>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="24"/>
            <Setter Property="Padding" Value="18"/>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Background" Value="#0B63F6"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="LightButton" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="DangerButton" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Background" Value="#FEE2E2"/>
            <Setter Property="Foreground" Value="#DC2626"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </UserControl.Resources>

    <TabControl Margin="16" Background="Transparent" BorderThickness="0">
        <TabItem Header="Hàng đợi pha chế">
            <Grid Margin="0,12,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" LastChildFill="False">
            <TextBlock Text="Pha chế"
                       FontSize="28"
                       FontWeight="Bold"
                       Foreground="#0F172A"
                       VerticalAlignment="Center"
                       DockPanel.Dock="Left"/>

            <Button Content="↻ Làm mới"
                    Width="116"
                    Style="{StaticResource LightButton}"
                    DockPanel.Dock="Right"
                    Command="{Binding LoadCommand}"/>
        </DockPanel>

        <UniformGrid Grid.Row="1"
                     Columns="4"
                     Margin="0,8,0,10">

            <Border Background="#FFF7ED" CornerRadius="16" Padding="10" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="Chờ làm" FontSize="12" Foreground="#9A3412"/>
                    <TextBlock Text="{Binding TongMonCho, Mode=OneWay}" FontSize="18" FontWeight="Bold" Foreground="#F97316" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>

            <Border Background="#EFF6FF" CornerRadius="16" Padding="10" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="Đang làm" FontSize="12" Foreground="#1D4ED8"/>
                    <TextBlock Text="{Binding TongMonDangLam, Mode=OneWay}" FontSize="18" FontWeight="Bold" Foreground="#2563EB" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>

            <Border Background="#ECFDF5" CornerRadius="16" Padding="10" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="Hoàn tất hôm nay" FontSize="12" Foreground="#166534"/>
                    <TextBlock Text="{Binding TongMonHoanTat, Mode=OneWay}" FontSize="18" FontWeight="Bold" Foreground="#10B981" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>

            <Border Background="#F8FAFC" CornerRadius="16" Padding="10">
                <StackPanel>
                    <TextBlock Text="Bill đang xử lý" FontSize="12" Foreground="#64748B"/>
                    <TextBlock Text="{Binding TongPhieuDangXuLy, Mode=OneWay}" FontSize="18" FontWeight="Bold" Foreground="#0F172A" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Chờ làm -->
            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,10,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,14">
                        <TextBlock Text="Chờ pha chế" FontSize="20" FontWeight="Bold" Foreground="#F97316" DockPanel.Dock="Left"/>
                        <TextBlock Text="{Binding MonMoi.Count, StringFormat={}{0} dòng}" FontSize="12" Foreground="#64748B" HorizontalAlignment="Right"/>
                    </DockPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding MonMoi}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#FFF7ED" BorderBrush="#FED7AA" BorderThickness="1" CornerRadius="18" Padding="14" Margin="0,0,0,12" Height="210">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <DockPanel Grid.Row="0">
                                                <StackPanel DockPanel.Dock="Left">
                                                    <TextBlock Text="{Binding MaHoaDonHienThi}" FontWeight="Bold" Foreground="#0F172A"/>
                                                    <TextBlock Text="{Binding ViTriText}" FontSize="12" Foreground="#64748B" Margin="0,3,0,0"/>
                                                </StackPanel>

                                                <Border Background="{Binding TrangThaiBackground}" CornerRadius="11" Padding="8,4" DockPanel.Dock="Right">
                                                    <TextBlock Text="{Binding TrangThaiText}" Foreground="{Binding TrangThaiColor}" FontSize="11" FontWeight="SemiBold"/>
                                                </Border>
                                            </DockPanel>

                                            <StackPanel Grid.Row="1" Margin="0,10,0,10">
                                                <DockPanel>
                                                    <TextBlock Text="{Binding TenMon}" FontSize="16" FontWeight="Bold" Foreground="#0F172A" TextWrapping="Wrap" DockPanel.Dock="Left"/>
                                                    <TextBlock Text="{Binding SoLuongText}" FontSize="16" FontWeight="Bold" Foreground="#F97316" HorizontalAlignment="Right"/>
                                                </DockPanel>

                                                <TextBlock Text="{Binding GhiChuMonText}" FontSize="12" Foreground="#9A3412" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                                <TextBlock Text="{Binding GhiChuHoaDonText}" FontSize="12" Foreground="#64748B" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                                <TextBlock Text="{Binding CongThucHienThi}" FontSize="11" Foreground="#0B63F6" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                            </StackPanel>

                                            <Grid Grid.Row="2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="8"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Button Grid.Column="0"
                                                        Content="Nhận món"
                                                        Style="{StaticResource PrimaryButton}"
                                                        Background="#F97316"
                                                        Command="{Binding DataContext.NhanMonCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"/>
                                                <Button Grid.Column="2"
                                                        Content="Hủy món"
                                                        Style="{StaticResource DangerButton}"
                                                        Command="{Binding DataContext.HuyMonCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"/>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Đang làm -->
            <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="5,0,5,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,14">
                        <TextBlock Text="Đang làm" FontSize="20" FontWeight="Bold" Foreground="#2563EB" DockPanel.Dock="Left"/>
                        <TextBlock Text="{Binding MonDangPha.Count, StringFormat={}{0} dòng}" FontSize="12" Foreground="#64748B" HorizontalAlignment="Right"/>
                    </DockPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding MonDangPha}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="18" Padding="14" Margin="0,0,0,12" Height="210">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <DockPanel Grid.Row="0">
                                                <StackPanel DockPanel.Dock="Left">
                                                    <TextBlock Text="{Binding MaHoaDonHienThi}" FontWeight="Bold" Foreground="#0F172A"/>
                                                    <TextBlock Text="{Binding ViTriText}" FontSize="12" Foreground="#64748B" Margin="0,3,0,0"/>
                                                </StackPanel>
                                                <Border Background="{Binding TrangThaiBackground}" CornerRadius="11" Padding="8,4" DockPanel.Dock="Right">
                                                    <TextBlock Text="{Binding TrangThaiText}" Foreground="{Binding TrangThaiColor}" FontSize="11" FontWeight="SemiBold"/>
                                                </Border>
                                            </DockPanel>

                                            <StackPanel Grid.Row="1" Margin="0,10,0,10">
                                                <DockPanel>
                                                    <TextBlock Text="{Binding TenMon}" FontSize="16" FontWeight="Bold" Foreground="#0F172A" TextWrapping="Wrap" DockPanel.Dock="Left"/>
                                                    <TextBlock Text="{Binding SoLuongText}" FontSize="16" FontWeight="Bold" Foreground="#2563EB" HorizontalAlignment="Right"/>
                                                </DockPanel>
                                                <TextBlock Text="{Binding GhiChuMonText}" FontSize="12" Foreground="#1D4ED8" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                                <TextBlock Text="{Binding GhiChuHoaDonText}" FontSize="12" Foreground="#64748B" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                                <TextBlock Text="{Binding CongThucHienThi}" FontSize="11" Foreground="#0B63F6" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                            </StackPanel>

                                            <Grid Grid.Row="2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="8"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Button Grid.Column="0"
                                                        Content="Hoàn tất"
                                                        Style="{StaticResource PrimaryButton}"
                                                        Command="{Binding DataContext.HoanTatCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"/>
                                                <Button Grid.Column="2"
                                                        Content="Hủy món"
                                                        Style="{StaticResource DangerButton}"
                                                        Command="{Binding DataContext.HuyMonCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"/>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Hoàn tất -->
            <Border Grid.Column="2" Style="{StaticResource CardStyle}" Margin="10,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,14">
                        <TextBlock Text="Hoàn tất hôm nay" FontSize="20" FontWeight="Bold" Foreground="#10B981" DockPanel.Dock="Left"/>
                        <TextBlock Text="{Binding MonHoanTat.Count, StringFormat={}{0} dòng}" FontSize="12" Foreground="#64748B" HorizontalAlignment="Right"/>
                    </DockPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding MonHoanTat}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#ECFDF5" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="18" Padding="14" Margin="0,0,0,12" Height="178">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>

                                            <DockPanel Grid.Row="0">
                                                <StackPanel DockPanel.Dock="Left">
                                                    <TextBlock Text="{Binding MaHoaDonHienThi}" FontWeight="Bold" Foreground="#0F172A"/>
                                                    <TextBlock Text="{Binding ViTriText}" FontSize="12" Foreground="#64748B" Margin="0,3,0,0"/>
                                                </StackPanel>
                                                <Border Background="{Binding TrangThaiBackground}" CornerRadius="11" Padding="8,4" DockPanel.Dock="Right">
                                                    <TextBlock Text="{Binding TrangThaiText}" Foreground="{Binding TrangThaiColor}" FontSize="11" FontWeight="SemiBold"/>
                                                </Border>
                                            </DockPanel>

                                            <StackPanel Grid.Row="1" Margin="0,10,0,0">
                                                <DockPanel>
                                                    <TextBlock Text="{Binding TenMon}" FontSize="16" FontWeight="Bold" Foreground="#0F172A" TextWrapping="Wrap" DockPanel.Dock="Left"/>
                                                    <TextBlock Text="{Binding SoLuongText}" FontSize="16" FontWeight="Bold" Foreground="#10B981" HorizontalAlignment="Right"/>
                                                </DockPanel>
                                                <TextBlock Text="{Binding GhiChuMonText}" FontSize="12" Foreground="#166534" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                                <TextBlock Text="{Binding GhiChuHoaDonText}" FontSize="12" Foreground="#64748B" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                                <TextBlock Text="{Binding CongThucHienThi}" FontSize="11" Foreground="#0B63F6" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <TextBlock Grid.Row="3"
                   Text="{Binding ThongBao}"
                   Foreground="#0B63F6"
                   FontWeight="SemiBold"
                   TextWrapping="Wrap"
                   Margin="0,12,0,0"/>
            </Grid>
        </TabItem>

        <TabItem Header="Công thức món">
            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="400"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,12,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0" Margin="0,0,0,12">
                            <StackPanel DockPanel.Dock="Left">
                                <TextBlock Text="Công thức pha chế" FontSize="22" FontWeight="Bold" Foreground="#0F172A"/>
                                <TextBlock Text="Chỉ cho phép khai báo công thức cho món đang có trong danh sách sản phẩm hiện tại." FontSize="12" Foreground="#64748B" Margin="0,4,0,0"/>
                            </StackPanel>
                            <Button Content="↻ Làm mới" Width="110" Style="{StaticResource LightButton}" DockPanel.Dock="Right" Command="{Binding LoadCongThucCommand}"/>
                        </DockPanel>

                        <Grid Grid.Row="1" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="220"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox Grid.Column="0" Height="40" ItemsSource="{Binding DanhSachMonCongThuc}" SelectedItem="{Binding MonCongThucDangChon, Mode=TwoWay}" DisplayMemberPath="HienThi" Margin="0,0,10,0"/>
                            <TextBlock Grid.Column="1" Text="Danh sách dưới đây là công thức của món đang chọn" Foreground="#64748B" TextWrapping="Wrap" FontSize="12" VerticalAlignment="Center"/>
                        </Grid>

                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding DanhSachCongThuc}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand"
                                                Command="{Binding DataContext.ChonDongCongThucCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}">
                                            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="18" Padding="14" Margin="0,0,0,10">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="130"/>
                                                        <ColumnDefinition Width="90"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="{Binding TenNguyenLieu}" FontSize="15" FontWeight="Bold" Foreground="#0F172A"/>
                                                        <TextBlock Text="{Binding MonText}" FontSize="12" Foreground="#64748B" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                                        <TextBlock Text="{Binding GhiChu}" FontSize="12" Foreground="#64748B" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="Định lượng" FontSize="11" Foreground="#64748B"/>
                                                        <TextBlock Text="{Binding DinhLuongText}" FontSize="14" FontWeight="Bold" Foreground="#0B63F6" Margin="0,4,0,0"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                                        <TextBlock Text="Hao hụt" FontSize="11" Foreground="#64748B" HorizontalAlignment="Right"/>
                                                        <TextBlock Text="{Binding HaoHutText}" FontSize="14" FontWeight="Bold" Foreground="#F97316" Margin="0,4,0,0" HorizontalAlignment="Right"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="Thêm / sửa công thức" FontSize="22" FontWeight="Bold" Foreground="#0F172A"/>
                            <TextBlock Text="Chọn món, chọn nguyên liệu, nhập định lượng rồi bấm Lưu. Nếu món + nguyên liệu đã tồn tại thì hệ thống cập nhật dòng cũ." FontSize="12" Foreground="#64748B" TextWrapping="Wrap" Margin="0,5,0,16"/>

                            <TextBlock Text="Món" FontWeight="SemiBold" Foreground="#334155"/>
                            <ComboBox ItemsSource="{Binding DanhSachMonCongThuc}" SelectedItem="{Binding MonCongThucDangChon, Mode=TwoWay}" DisplayMemberPath="HienThi" Height="40" Margin="0,6,0,12"/>

                            <TextBlock Text="Nguyên liệu" FontWeight="SemiBold" Foreground="#334155"/>
                            <ComboBox ItemsSource="{Binding DanhSachNguyenLieuCongThuc}" SelectedItem="{Binding NguyenLieuCongThucDangChon, Mode=TwoWay}" DisplayMemberPath="TenNguyenLieu" Height="40" Margin="0,6,0,12"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Số lượng cần" FontWeight="SemiBold" Foreground="#334155"/>
                                    <TextBox Text="{Binding SoLuongCanNhap, UpdateSourceTrigger=PropertyChanged}" Height="40" Margin="0,6,0,12" Padding="10,0" VerticalContentAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Hao hụt %" FontWeight="SemiBold" Foreground="#334155"/>
                                    <TextBox Text="{Binding PhanTramHaoHutNhap, UpdateSourceTrigger=PropertyChanged}" Height="40" Margin="0,6,0,12" Padding="10,0" VerticalContentAlignment="Center"/>
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="Ghi chú" FontWeight="SemiBold" Foreground="#334155"/>
                            <TextBox Text="{Binding GhiChuCongThucNhap, UpdateSourceTrigger=PropertyChanged}" Height="78" Margin="0,6,0,14" Padding="10" TextWrapping="Wrap" AcceptsReturn="True"/>

                            <Button Content="Lưu công thức" Style="{StaticResource PrimaryButton}" Command="{Binding LuuCongThucCommand}"/>
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="Xóa dòng" Style="{StaticResource DangerButton}" Command="{Binding XoaCongThucCommand}"/>
                                <Button Grid.Column="2" Content="Reset form" Style="{StaticResource LightButton}" Command="{Binding ResetCongThucFormCommand}"/>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </TabItem>
    </TabControl>
</UserControl>
