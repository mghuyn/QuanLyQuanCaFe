<Window x:Class="QuanLyQuanCaFe.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:QuanLyQuanCaFe.ViewModels"
        Title="Đăng nhập BrewPOS"
        Width="1080"
        Height="680"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F6F8FC">

    <Window.DataContext>
        <vm:LoginViewModel/>
    </Window.DataContext>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
          
        </Grid.ColumnDefinitions>

       

        <Grid Grid.Column="1" Background="White">
            <Border Width="340"
                    Padding="0"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center">

                <StackPanel>
                    <TextBlock Text="Đăng nhập"
                               FontSize="32"
                               FontWeight="Bold"
                               Foreground="#0F172A"
                               HorizontalAlignment="Center"/>

                    <TextBlock Text="Chào mừng bạn quay lại"
                               FontSize="14"
                               Foreground="#64748B"
                               HorizontalAlignment="Center"
                               Margin="0,8,0,32"/>

                    <TextBlock Text="Tên đăng nhập"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="#334155"/>

                    <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                             Height="46"
                             FontSize="14"
                             Padding="14,0"
                             Margin="0,8,0,18"
                             VerticalContentAlignment="Center"/>

                    <TextBlock Text="Mật khẩu"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="#334155"/>

                    <PasswordBox x:Name="PasswordInput"
                                 Height="46"
                                 FontSize="14"
                                 Padding="14,0"
                                 Margin="0,8,0,12"
                                 VerticalContentAlignment="Center"/>

                    <TextBlock Text="{Binding ErrorMessage}"
                               Foreground="#DC2626"
                               FontSize="13"
                               TextWrapping="Wrap"
                               MinHeight="22"
                               Margin="0,0,0,12"/>

                    <Button Content="Đăng nhập"
                            Height="48"
                            Background="#0B63F6"
                            Foreground="White"
                            FontSize="15"
                            FontWeight="Bold"
                            BorderThickness="0"
                            Cursor="Hand"
                            Command="{Binding LoginCommand}"
                            CommandParameter="{Binding ElementName=PasswordInput}"/>

                    <TextBlock Text="BrewPOS © 2026"
                               Foreground="#94A3B8"
                               FontSize="12"
                               HorizontalAlignment="Center"
                               Margin="0,32,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>