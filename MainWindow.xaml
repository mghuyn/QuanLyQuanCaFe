<Window x:Class="QuanLyQuanCaFe.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:QuanLyQuanCaFe.ViewModels"
        Title="BrewPOS"
        Height="820"
        Width="1360"
        WindowStartupLocation="CenterScreen"
        Background="#EEF3FA">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="White"
                CornerRadius="22"
                Padding="14"
                Margin="0,0,14,0">
            <DockPanel>

                <StackPanel DockPanel.Dock="Top">
                    <StackPanel Orientation="Horizontal" Margin="4,6,0,28">
                        <TextBlock Text="☕"
                                   FontSize="30"
                                   Foreground="#0B63F6"
                                   VerticalAlignment="Center"/>
                        <!--<TextBlock Text="BrewPOS"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Foreground="#0B63F6"
                                   Margin="10,0,0,0"
                                   VerticalAlignment="Center"/>-->
                    </StackPanel>

                    <ItemsControl ItemsSource="{Binding MenuItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Command="{Binding Command}"
                                        CommandParameter="{Binding MaManHinh}"
                                        Height="46"
                                        Margin="0,4"
                                        HorizontalContentAlignment="Stretch"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Cursor="Hand">
                                    <Border CornerRadius="14"
                                            Padding="10,0"
                                            Background="{Binding ActiveBackground}">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="30"
                                                    Height="30"
                                                    CornerRadius="10"
                                                    Background="{Binding ActiveIconBackground}"
                                                    VerticalAlignment="Center"
                                                    Margin="0,0,8,0">
                                                <TextBlock Text="{Binding BieuTuong}"
                                                           FontSize="17"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Text="{Binding TieuDe}"
                                                       FontSize="14"
                                                       FontWeight="SemiBold"
                                                       Foreground="{Binding ActiveForeground}"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <Border DockPanel.Dock="Bottom"
                        Background="#F1F6FF"
                        CornerRadius="18"
                        Padding="14"
                        Margin="0,20,0,0">
                    <StackPanel>
                        <TextBlock Text="Chi nhánh trung tâm"
                                   FontWeight="SemiBold"
                                   Foreground="#0F172A"/>
                        <TextBlock Text="Đang hoạt động"
                                   FontSize="12"
                                   Foreground="#64748B"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="{Binding TopBarHeight}"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Visibility="{Binding TopBarVisibility}"
                    Background="White"
                    CornerRadius="24"
                    Padding="24,0"
                    Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding PageTitle}"
           FontSize="18"
           FontWeight="Bold"
           VerticalAlignment="Center"/>

                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">

                        <Border Width="280"
        Height="44"
        Background="#F8FAFC"
        CornerRadius="16"
        Padding="14,0"
        Margin="0,0,14,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="26"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="🔍"
                   FontSize="14"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Center"
                   Foreground="#64748B"/>

                                <TextBox Grid.Column="1"
                 BorderThickness="0"
                 Background="Transparent"
                 Text="Tìm kiếm nhanh..."
                 FontSize="13"
                 Foreground="#94A3B8"
                 Padding="6,0,0,0"
                 VerticalContentAlignment="Center"/>
                            </Grid>
                        </Border>

                        <Border Width="42"
                                Height="42"
                                Background="#F8FAFC"
                                CornerRadius="14"
                                Margin="0,0,12,0">
                            <TextBlock Text="🔔"
                                       FontSize="18"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <Button Command="{Binding LogoutCommand}"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="0"
                                Cursor="Hand">
                            <Border Height="42"
                                    Background="#F8FAFC"
                                    CornerRadius="14"
                                    Padding="12,0">
                                <StackPanel Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="👤"
                                               FontSize="18"
                                               Margin="0,0,8,0"/>
                                    <StackPanel>
                                        <TextBlock Text="{Binding TenNhanVien}"  FontSize="13"  FontWeight="Bold"  Foreground="#0F172A"/>

                                        <TextBlock Text="{Binding TenVaiTro}"  FontSize="11"  Foreground="#64748B"/>
                                    </StackPanel>
                                    <TextBlock Text="  ⎋" FontSize="14" Foreground="#64748B" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="1"
                    Background="White"
                    CornerRadius="24"
                    Padding="0">
                <ContentControl Content="{Binding CurrentView}"/>
            </Border>
        </Grid>
    </Grid>
</Window>